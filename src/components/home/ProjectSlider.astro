---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getProjectCopy } from '../../i18n/projects';
import { formatMessagePair, messages } from '../../i18n/site';

interface ProjectSlide {
  id: string;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  projects: ProjectSlide[];
}

const { projects } = Astro.props;

const projectMotifs = {
  'astral-days': {
    main: '4,72 18,53 34,60 49,35 66,45 82,22 95,32',
    branch: '49,35 53,76 71,69 88,86',
    points: [
      [4, 72, 2.1, 'warm'],
      [18, 53, 1.6, 'cool'],
      [34, 60, 2.4, 'cool'],
      [49, 35, 2, 'warm'],
      [66, 45, 1.7, 'cool'],
      [82, 22, 2.2, 'cool'],
      [95, 32, 1.5, 'cool'],
      [53, 76, 1.5, 'cool'],
      [71, 69, 1.35, 'cool'],
      [88, 86, 1.8, 'warm'],
    ],
  },
  'project-vx': {
    main: '7,76 22,54 41,61 58,29 76,46 93,19',
    branch: '22,54 22,28 58,28 76,13',
    signal: '41,61 41,82 68,82 84,67',
    points: [
      [7, 76, 1.8, 'cool'],
      [22, 54, 2.4, 'warm'],
      [41, 61, 1.7, 'cool'],
      [58, 29, 2.2, 'cool'],
      [76, 46, 1.65, 'cool'],
      [93, 19, 2.1, 'cool'],
      [22, 28, 1.4, 'cool'],
      [76, 13, 1.35, 'warm'],
      [41, 82, 1.35, 'cool'],
      [68, 82, 1.6, 'cool'],
      [84, 67, 1.5, 'cool'],
    ],
  },
} as const;
---

<section
  id="featured-projects"
  class="project-slider snap-section"
  aria-roledescription={messages.ja['home.slider.roledescription']}
  data-i18n-aria-roledescription="home.slider.roledescription"
  aria-label={messages.ja['home.slider.label']}
  data-i18n-aria="home.slider.label"
  data-project-slider
  tabindex="0"
>
  <div class="slides" aria-live="off">
    {projects.map((project, index) => {
      const copy = getProjectCopy(project.id);
      const motif = projectMotifs[project.id as keyof typeof projectMotifs] ?? projectMotifs['astral-days'];
      return (
      <article
        class:list={['slide', { 'is-active': index === 0 }]}
        aria-hidden={index === 0 ? 'false' : 'true'}
        data-slide
        data-project-id={project.id}
      >
        <Image
          class="slide-image"
          src={project.image}
          alt={project.imageAlt}
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="100vw"
          format="webp"
          quality={86}
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
        <div class="slide-shade" aria-hidden="true"></div>
        <div class="container slide-content">
          <div class="slide-copy">
            <div class:list={['oled-constellation', `oled-constellation--${project.id}`]} aria-hidden="true">
              <svg class="oled-constellation-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
                {project.id === 'project-vx' && (
                  <g class="oled-constellation-grid">
                    <path d="M22 10v80M41 10v80M58 10v80M76 10v80" />
                    <path d="M5 28h90M5 54h90M5 82h90" />
                  </g>
                )}
                <polyline class="oled-constellation-main" points={motif.main} />
                <polyline class="oled-constellation-branch" points={motif.branch} />
                {'signal' in motif && <polyline class="oled-constellation-signal" points={motif.signal} />}
              </svg>
              {motif.points.map(([x, y, radius, tone]) => (
                <span
                  class:list={['oled-star', `oled-star--${tone}`]}
                  style={`--star-x: ${x}%; --star-y: ${y}%; --star-scale: ${radius / 1.8};`}
                ></span>
              ))}
            </div>
            <h1 data-locale-ja={copy.ja.title} data-locale-ko={copy.ko.title}>{copy.ja.title}</h1>
            <p data-locale-ja={copy.ja.summary} data-locale-ko={copy.ko.summary}>{copy.ja.summary}</p>
            <a class="project-cta" href={'/projects/' + project.id + '/'}>
              <span data-i18n="project.open">{messages.ja['project.open']}</span>
            </a>
          </div>
        </div>
      </article>
      );
    })}
  </div>

  <div class="slide-refraction" aria-hidden="true">
    <span class="slide-refraction__beam slide-refraction__beam--wide"></span>
    <span class="slide-refraction__beam slide-refraction__beam--fine"></span>
  </div>

  <div class="container slider-ui">
    <div class="slide-count" aria-hidden="true">
      <span data-current-count>01</span>
      <span class="count-rule"></span>
      <span>{String(projects.length).padStart(2, '0')}</span>
    </div>

    <div class="slider-actions">
      <div class="slide-selectors" role="tablist" aria-label={messages.ja['home.slider.selector']} data-i18n-aria="home.slider.selector">
        {projects.map((project, index) => {
          const copy = getProjectCopy(project.id);
          const selectorLabel = formatMessagePair('home.slider.show', { title: copy.ja.title });
          const selectorLabelKo = formatMessagePair('home.slider.show', { title: copy.ko.title });
          const announcement = formatMessagePair('home.slider.shown', { title: copy.ja.title });
          const announcementKo = formatMessagePair('home.slider.shown', { title: copy.ko.title });
          return (
          <button
            type="button"
            role="tab"
            class:list={{ 'is-active': index === 0 }}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={selectorLabel.ja}
            data-locale-aria-ja={selectorLabel.ja}
            data-locale-aria-ko={selectorLabelKo.ko}
            data-slide-announcement-ja={announcement.ja}
            data-slide-announcement-ko={announcementKo.ko}
            data-slide-selector={index}
          >
            <span class="selector-line" aria-hidden="true"><span class="selector-progress"></span></span>
            <span data-locale-ja={copy.ja.title} data-locale-ko={copy.ko.title}>{copy.ja.title}</span>
          </button>
          );
        })}
      </div>
    </div>
  </div>

  <p class="sr-only" aria-live="polite" data-slide-status></p>
</section>

<script>
  const sliders = document.querySelectorAll<HTMLElement>('[data-project-slider]');

  sliders.forEach((slider) => {
    const cycleDuration = 10000;
    const transitionDuration = 920;
    const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
    const selectors = [...slider.querySelectorAll<HTMLButtonElement>('[data-slide-selector]')];
    const currentCount = slider.querySelector<HTMLElement>('[data-current-count]');
    const status = slider.querySelector<HTMLElement>('[data-slide-status]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let timer: number | undefined;
    let transitionTimer: number | undefined;
    let pointerStartX: number | undefined;
    let cycleStartedAt = 0;
    let cycleRemaining = cycleDuration;
    const pauseReasons = new Set<string>();

    const restartProgress = () => {
      slider.classList.remove('is-cycle-running');
      void slider.offsetWidth;
      slider.classList.add('is-cycle-running');
    };

    const updateLocalizedStatus = () => {
      if (!status) return;
      const selector = selectors[activeIndex];
      status.textContent = document.documentElement.lang === 'ko'
        ? selector?.dataset.slideAnnouncementKo ?? ''
        : selector?.dataset.slideAnnouncementJa ?? '';
    };

    const playRefraction = () => {
      if (reduceMotion) return;
      if (transitionTimer !== undefined) window.clearTimeout(transitionTimer);
      slider.classList.remove('is-transitioning');
      void slider.offsetWidth;
      slider.classList.add('is-transitioning');
      transitionTimer = window.setTimeout(() => {
        slider.classList.remove('is-transitioning');
        transitionTimer = undefined;
      }, transitionDuration);
    };

    const selectSlide = (index: number, announce = true, withTransition = true) => {
      const previousIndex = activeIndex;
      const nextIndex = (index + slides.length) % slides.length;
      if (nextIndex === previousIndex && slider.classList.contains('is-ready')) return;
      const previousSlide = slides[previousIndex];
      const nextSlide = slides[nextIndex];

      activeIndex = nextIndex;

      if (withTransition && previousSlide && nextSlide) {
        previousSlide.classList.add('is-leaving');
        playRefraction();
        window.setTimeout(() => previousSlide.classList.remove('is-leaving'), reduceMotion ? 0 : transitionDuration);
      }

      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === activeIndex;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });

      selectors.forEach((selector, selectorIndex) => {
        const active = selectorIndex === activeIndex;
        selector.classList.toggle('is-active', active);
        selector.setAttribute('aria-selected', String(active));
      });

      if (currentCount) currentCount.textContent = String(activeIndex + 1).padStart(2, '0');
      if (announce && status) {
        updateLocalizedStatus();
      }
    };

    const clearTimer = () => {
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
    };

    const pauseCycle = () => {
      if (timer !== undefined) {
        cycleRemaining = Math.max(cycleRemaining - (performance.now() - cycleStartedAt), 0);
      }
      clearTimer();
      slider.classList.add('is-autoplay-paused');
    };

    const resumeCycle = () => {
      if (reduceMotion || document.hidden || pauseReasons.size > 0 || timer !== undefined) return;
      slider.classList.remove('is-autoplay-paused');
      cycleStartedAt = performance.now();
      timer = window.setTimeout(() => {
        selectSlide(activeIndex + 1, false);
        resetCycle();
      }, cycleRemaining);
    };

    const resetCycle = () => {
      clearTimer();
      cycleRemaining = cycleDuration;
      restartProgress();
      if (reduceMotion || document.hidden || pauseReasons.size > 0) {
        slider.classList.add('is-autoplay-paused');
        return;
      }
      resumeCycle();
    };

    const setPauseReason = (reason: string, paused: boolean) => {
      if (paused) pauseReasons.add(reason);
      else pauseReasons.delete(reason);

      if (pauseReasons.size > 0 || document.hidden) pauseCycle();
      else resumeCycle();
    };

    selectors.forEach((selector, index) => {
      selector.addEventListener('click', () => {
        selectSlide(index);
        resetCycle();
      });
    });

    slider.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        selectSlide(activeIndex - 1);
        resetCycle();
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        selectSlide(activeIndex + 1);
        resetCycle();
      }
    });

    slider.addEventListener('pointerdown', (event) => {
      pointerStartX = event.clientX;
    });
    slider.addEventListener('pointerup', (event) => {
      if (pointerStartX === undefined) return;
      const distance = event.clientX - pointerStartX;
      if (Math.abs(distance) > 56) {
        const direction = distance < 0 ? 1 : -1;
        selectSlide(activeIndex + direction);
      }
      pointerStartX = undefined;
      resetCycle();
    });

    slider.addEventListener('focusin', (event) => {
      const target = event.target;
      setPauseReason('focus', target instanceof HTMLElement && target.matches(':focus-visible'));
    });
    slider.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && slider.contains(event.relatedTarget)) return;
      setPauseReason('focus', false);
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pauseCycle();
      else if (pauseReasons.size === 0) resumeCycle();
    });
    document.addEventListener('site:localechange', updateLocalizedStatus);

    window.requestAnimationFrame(() => {
      slider.classList.add('is-ready');
      resetCycle();
    });
  });
</script>

<style>
  .project-slider {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    color: var(--color-text);
    background: var(--color-canvas-deep);
  }

  .slides,
  .slide,
  .slide :global(picture),
  .slide-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide {
    z-index: 0;
    visibility: hidden;
    opacity: 0;
    clip-path: polygon(-18% 0, -18% 0, -34% 100%, -34% 100%);
    transition:
      clip-path 900ms cubic-bezier(0.46, 0, 0.2, 1),
      opacity 440ms ease,
      visibility 900ms step-end;
  }

  .slide.is-active {
    z-index: 2;
    visibility: visible;
    opacity: 1;
    clip-path: polygon(0 0, 118% 0, 102% 100%, -16% 100%);
    transition:
      clip-path 900ms cubic-bezier(0.46, 0, 0.2, 1),
      opacity 440ms ease,
      visibility 0ms step-start;
  }

  .slide.is-leaving {
    z-index: 1;
    visibility: visible;
    opacity: 1;
    clip-path: inset(0);
    transition: none;
  }

  .slide-image {
    object-fit: cover;
    object-position: center;
    transform: scale(1.015);
    transition: transform 10s ease-out;
  }

  .slide.is-active .slide-image {
    transform: scale(1);
  }

  .slide-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(3 10 19 / 12%) 36%, rgb(3 10 19 / 88%) 100%),
      linear-gradient(90deg, rgb(3 10 19 / 38%) 0%, transparent 55%);
  }

  .slide-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding-block: calc(var(--header-height) + var(--space-7)) clamp(8.5rem, 17vh, 11rem);
  }

  .slide-copy {
    position: relative;
    max-width: 50rem;
    padding: clamp(1.3rem, 2.7vw, 2.7rem);
    overflow: hidden;
    border: 1px solid rgb(242 244 247 / 42%);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 7%), transparent 34%),
      rgb(3 10 19 / 34%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 16%),
      inset 1px 0 0 rgb(130 174 255 / 12%),
      0 1.5rem 5rem rgb(0 0 0 / 26%);
    backdrop-filter: blur(9px) saturate(116%);
  }

  .slide-copy::after {
    position: absolute;
    inset: auto 8% -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-dawn), transparent);
    box-shadow: 0 0 0.8rem rgb(255 138 61 / 44%);
    content: '';
  }

  .slide-copy > h1,
  .slide-copy > p,
  .slide-copy > .project-cta {
    opacity: 0.08;
    transform: translate3d(0, 0.72rem, 0);
    transition:
      opacity 620ms ease,
      transform 700ms cubic-bezier(0.22, 0.76, 0.25, 1);
  }

  .project-slider.is-ready .slide.is-active .slide-copy > h1,
  .project-slider.is-ready .slide.is-active .slide-copy > p,
  .project-slider.is-ready .slide.is-active .slide-copy > .project-cta {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .project-slider.is-ready .slide.is-active .slide-copy > p {
    transition-delay: 90ms;
  }

  .project-slider.is-ready .slide.is-active .slide-copy > .project-cta {
    transition-delay: 170ms;
  }

  .slide.is-leaving .slide-copy > h1,
  .slide.is-leaving .slide-copy > p,
  .slide.is-leaving .slide-copy > .project-cta {
    opacity: 0.04;
    transform: translate3d(0, -0.45rem, 0);
    transition-delay: 0ms;
    transition-duration: 300ms;
  }

  .slide-copy h1 {
    max-width: 16ch;
    font-size: clamp(1.88rem, 4vw, 4rem);
    letter-spacing: -0.035em;
    text-shadow: 0 0.15rem 1.2rem rgb(0 0 0 / 45%);
  }

  .slide-copy p {
    max-width: 42rem;
    margin-top: var(--space-4);
    color: var(--color-text-soft);
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    text-shadow: 0 0.1rem 0.8rem rgb(0 0 0 / 58%);
  }

  .project-cta {
    min-width: 18rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-5);
    padding: 0.9rem 1.3rem;
    border: 1px solid var(--color-dawn);
    color: var(--color-dawn-soft);
    font-family: var(--font-ja);
    text-decoration: none;
    background: rgb(3 10 19 / 35%);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .project-cta:hover {
    color: var(--color-canvas-deep);
    background: var(--color-dawn);
  }

  .slider-ui {
    position: absolute;
    z-index: 4;
    right: 0;
    bottom: var(--space-6);
    left: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    pointer-events: none;
  }

  .slide-refraction {
    position: absolute;
    z-index: 3;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .slide-refraction::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(112deg, transparent 38%, rgb(197 226 255 / 8%) 48%, rgb(255 177 118 / 7%) 52%, transparent 62%);
    content: '';
    opacity: 0;
  }

  .slide-refraction__beam {
    position: absolute;
    top: -18%;
    left: -38%;
    width: 34%;
    height: 145%;
    background: linear-gradient(90deg, transparent, rgb(214 235 255 / 30%), transparent);
    filter: blur(1px);
    transform: skewX(-14deg) translateX(0);
  }

  .slide-refraction__beam--fine {
    left: -48%;
    width: 24%;
    background: linear-gradient(90deg, transparent, rgb(255 182 127 / 24%), transparent);
  }

  .project-slider.is-transitioning .slide-refraction {
    opacity: 1;
    animation: slide-refraction-visibility 920ms ease both;
  }

  .project-slider.is-transitioning .slide-refraction::before {
    animation: slide-refraction-plane 920ms ease both;
  }

  .project-slider.is-transitioning .slide-refraction__beam--wide {
    animation: slide-refraction-wide 920ms cubic-bezier(0.36, 0, 0.26, 1) both;
  }

  .project-slider.is-transitioning .slide-refraction__beam--fine {
    animation: slide-refraction-fine 920ms cubic-bezier(0.39, 0, 0.22, 1) 45ms both;
  }

  .slide-count,
  .slider-actions {
    padding: 0.75rem 1rem;
    border: 1px solid rgb(182 206 255 / 34%);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 6%), transparent 38%),
      rgb(3 10 19 / 38%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 12%);
    backdrop-filter: blur(8px) saturate(112%);
  }

  .slider-ui button {
    pointer-events: auto;
  }

  .slide-count {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .slide-count [data-current-count] {
    color: var(--color-dawn);
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .count-rule {
    position: relative;
    overflow: hidden;
    width: 2.5rem;
    height: 1px;
    background: var(--color-line-strong);
  }

  .count-rule::after {
    position: absolute;
    inset: 0;
    background: var(--color-dawn);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
  }

  .slider-actions {
    display: flex;
    align-items: flex-end;
    gap: var(--space-6);
  }

  .slide-selectors {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
  }

  .slide-selectors button {
    max-width: 11rem;
    display: grid;
    gap: var(--space-2);
    border: 0;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: var(--step--1);
    text-align: left;
    background: transparent;
  }

  .selector-line {
    position: relative;
    display: block;
    overflow: hidden;
    width: 2.4rem;
    height: 2px;
    background: var(--color-line-strong);
    transition: width var(--transition-base), background var(--transition-base);
  }

  .selector-progress {
    position: absolute;
    inset: 0;
    background: var(--color-dawn);
    box-shadow: 0 0 0.55rem rgb(255 138 61 / 48%);
    transform: scaleX(0);
    transform-origin: left;
  }

  .slide-selectors button.is-active {
    color: var(--color-text);
  }

  .slide-selectors button.is-active .selector-line {
    width: 4rem;
    background: rgb(255 138 61 / 22%);
  }

  .project-slider.is-cycle-running .slide-selectors button.is-active .selector-progress,
  .project-slider.is-cycle-running .count-rule::after {
    animation: slider-cycle-progress 10s linear both;
  }

  .project-slider.is-autoplay-paused .selector-progress,
  .project-slider.is-autoplay-paused .count-rule::after {
    animation-play-state: paused !important;
  }

  .oled-constellation {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.18;
    transform: translate3d(0, 0, 0);
    transform-origin: 48% 52%;
    will-change: transform;
  }

  .slide.is-active .oled-constellation {
    animation: hero-constellation-drift 10.5s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite alternate;
  }

  .slide:nth-child(even).is-active .oled-constellation {
    animation-direction: alternate-reverse;
    animation-duration: 12s;
  }

  .oled-constellation-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .oled-constellation-lines polyline,
  .oled-constellation-grid path {
    fill: none;
    stroke: var(--color-moon);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 0.34;
  }

  .oled-constellation--astral-days .oled-constellation-main {
    stroke: rgb(176 211 255 / 78%);
  }

  .oled-constellation--astral-days .oled-constellation-branch {
    stroke: rgb(255 177 125 / 64%);
    stroke-dasharray: 1.4 1.2;
  }

  .oled-constellation--project-vx .oled-constellation-main {
    stroke: rgb(147 193 255 / 78%);
  }

  .oled-constellation--project-vx .oled-constellation-branch,
  .oled-constellation--project-vx .oled-constellation-signal {
    stroke: rgb(130 174 255 / 60%);
    stroke-dasharray: 1 1.8;
  }

  .oled-constellation-grid {
    opacity: 0.13;
  }

  .oled-constellation-grid path {
    stroke-width: 0.22;
  }

  .oled-constellation-lines .oled-constellation-branch {
    stroke: rgb(167 201 245 / 72%);
    stroke-dasharray: 1.2 1.1;
  }

  .oled-star {
    position: absolute;
    top: var(--star-y);
    left: var(--star-x);
    width: calc(0.31rem * var(--star-scale));
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-moon);
    box-shadow: 0 0 0.6rem var(--color-moon);
    transform: translate(-50%, -50%);
  }

  .oled-star--warm {
    background: var(--color-dawn);
    box-shadow: 0 0 0.65rem rgb(255 138 61 / 74%);
  }

  @keyframes slider-cycle-progress {
    to { transform: scaleX(1); }
  }

  @keyframes slide-refraction-visibility {
