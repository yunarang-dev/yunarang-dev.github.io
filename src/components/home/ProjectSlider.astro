---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getProjectCopy } from '../../i18n/projects';

interface ProjectSlide {
  id: string;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  projects: ProjectSlide[];
}

const { projects } = Astro.props;
---

<section
  class="project-slider snap-section"
  aria-roledescription="carousel"
  aria-label="メインプロジェクト"
  data-i18n-aria="home.slider.label"
  data-project-slider
  tabindex="0"
>
  <div class="slides" aria-live="off">
    {projects.map((project, index) => {
      const copy = getProjectCopy(project.id);
      return (
      <article
        class:list={['slide', { 'is-active': index === 0 }]}
        aria-hidden={index === 0 ? 'false' : 'true'}
        data-slide
      >
        <Image
          class="slide-image"
          src={project.image}
          alt={project.imageAlt}
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="100vw"
          format="webp"
          quality={86}
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
        <div class="slide-shade" aria-hidden="true"></div>
        <div class="container slide-content">
          <div class="slide-copy">
            <div class="oled-constellation" aria-hidden="true">
              <svg class="oled-constellation-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
                <polyline points="7,68 23,47 42,55 59,27 77,38 92,17" />
                <polyline class="oled-constellation-branch" points="42,55 53,79 70,67 84,84" />
              </svg>
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <h1 data-locale-ja={copy.ja.title} data-locale-ko={copy.ko.title}>{copy.ja.title}</h1>
            <p data-locale-ja={copy.ja.summary} data-locale-ko={copy.ko.summary}>{copy.ja.summary}</p>
            <a class="project-cta" href={'/projects/' + project.id + '/'}>
              <span data-i18n="project.open">プロジェクトを見る</span>
            </a>
          </div>
        </div>
      </article>
      );
    })}
  </div>

  <div class="container slider-ui">
    <div class="slide-count" aria-hidden="true">
      <span data-current-count>01</span>
      <span class="count-rule"></span>
      <span>{String(projects.length).padStart(2, '0')}</span>
    </div>

    <div class="slider-actions">
      <div class="slide-selectors" role="tablist" aria-label="プロジェクトを選択" data-i18n-aria="home.slider.selector">
        {projects.map((project, index) => {
          const copy = getProjectCopy(project.id);
          return (
          <button
            type="button"
            role="tab"
            class:list={{ 'is-active': index === 0 }}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={copy.ja.title + 'を表示'}
            data-locale-aria-ja={copy.ja.title + 'を表示'}
            data-locale-aria-ko={copy.ko.title + ' 표시'}
            data-slide-selector={index}
          >
            <span class="selector-line"></span>
            <span data-locale-ja={copy.ja.title} data-locale-ko={copy.ko.title}>{copy.ja.title}</span>
          </button>
          );
        })}
      </div>
    </div>
  </div>

  <p class="sr-only" aria-live="polite" data-slide-status></p>
</section>

<script>
  const sliders = document.querySelectorAll<HTMLElement>('[data-project-slider]');

  sliders.forEach((slider) => {
    const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
    const selectors = [...slider.querySelectorAll<HTMLButtonElement>('[data-slide-selector]')];
    const currentCount = slider.querySelector<HTMLElement>('[data-current-count]');
    const status = slider.querySelector<HTMLElement>('[data-slide-status]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let timer: number | undefined;
    let pointerStartX: number | undefined;

    const selectSlide = (index: number, announce = true) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === activeIndex;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });

      selectors.forEach((selector, selectorIndex) => {
        const active = selectorIndex === activeIndex;
        selector.classList.toggle('is-active', active);
        selector.setAttribute('aria-selected', String(active));
      });

      if (currentCount) currentCount.textContent = String(activeIndex + 1).padStart(2, '0');
      if (announce && status) {
        const title = selectors[activeIndex]?.textContent?.trim() ?? '';
        status.textContent = document.documentElement.lang === 'ko' ? title + '을(를) 표시했습니다' : title + 'を表示しました';
      }
    };

    const stopTimer = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    const startTimer = () => {
      stopTimer();
      if (!reduceMotion && !document.hidden) {
        timer = window.setInterval(() => selectSlide(activeIndex + 1, false), 10000);
      }
    };

    selectors.forEach((selector, index) => {
      selector.addEventListener('click', () => {
        selectSlide(index);
        startTimer();
      });
    });

    slider.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        selectSlide(activeIndex - 1);
        startTimer();
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        selectSlide(activeIndex + 1);
        startTimer();
      }
    });

    slider.addEventListener('pointerdown', (event) => {
      pointerStartX = event.clientX;
    });
    slider.addEventListener('pointerup', (event) => {
      if (pointerStartX === undefined) return;
      const distance = event.clientX - pointerStartX;
      if (Math.abs(distance) > 56) selectSlide(activeIndex + (distance < 0 ? 1 : -1));
      pointerStartX = undefined;
      startTimer();
    });

    slider.addEventListener('mouseenter', stopTimer);
    slider.addEventListener('mouseleave', startTimer);
    slider.addEventListener('focusin', stopTimer);
    slider.addEventListener('focusout', startTimer);
    document.addEventListener('visibilitychange', startTimer);
    startTimer();
  });
</script>

<style>
  .project-slider {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    color: var(--color-text);
    background: var(--color-canvas-deep);
  }

  .slides,
  .slide,
  .slide :global(picture),
  .slide-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide {
    visibility: hidden;
    opacity: 0;
    transition: opacity 700ms ease, visibility 700ms step-end;
  }

  .slide.is-active {
    visibility: visible;
    opacity: 1;
    transition: opacity 700ms ease, visibility 0ms step-start;
  }

  .slide-image {
    object-fit: cover;
    object-position: center;
    transform: scale(1.015);
    transition: transform 10s ease-out;
  }

  .slide.is-active .slide-image {
    transform: scale(1);
  }

  .slide-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(3 10 19 / 12%) 36%, rgb(3 10 19 / 88%) 100%),
      linear-gradient(90deg, rgb(3 10 19 / 38%) 0%, transparent 55%);
  }

  .slide-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding-block: calc(var(--header-height) + var(--space-7)) clamp(8.5rem, 17vh, 11rem);
  }

  .slide-copy {
    position: relative;
    max-width: 50rem;
    padding: clamp(1.3rem, 2.7vw, 2.7rem);
    overflow: hidden;
    border: 1px solid rgb(242 244 247 / 42%);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 7%), transparent 34%),
      rgb(3 10 19 / 34%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 16%),
      inset 1px 0 0 rgb(130 174 255 / 12%),
      0 1.5rem 5rem rgb(0 0 0 / 26%);
    backdrop-filter: blur(9px) saturate(116%);
  }

  .slide-copy::after {
    position: absolute;
    inset: auto 8% -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-dawn), transparent);
    box-shadow: 0 0 0.8rem rgb(255 138 61 / 44%);
    content: '';
  }

  .slide-copy h1 {
    max-width: 16ch;
    font-size: clamp(1.88rem, 4vw, 4rem);
    letter-spacing: -0.035em;
    text-shadow: 0 0.15rem 1.2rem rgb(0 0 0 / 45%);
  }

  .slide-copy p {
    max-width: 42rem;
    margin-top: var(--space-4);
    color: var(--color-text-soft);
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    text-shadow: 0 0.1rem 0.8rem rgb(0 0 0 / 58%);
  }

  .project-cta {
    min-width: 18rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-5);
    padding: 0.9rem 1.3rem;
    border: 1px solid var(--color-dawn);
    color: var(--color-dawn-soft);
    font-family: var(--font-ja);
    text-decoration: none;
    background: rgb(3 10 19 / 35%);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .project-cta:hover {
    color: var(--color-canvas-deep);
    background: var(--color-dawn);
  }

  .slider-ui {
    position: absolute;
    z-index: 4;
    right: 0;
    bottom: var(--space-6);
    left: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    pointer-events: none;
  }

  .slide-count,
  .slider-actions {
    padding: 0.75rem 1rem;
    border: 1px solid rgb(182 206 255 / 34%);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 6%), transparent 38%),
      rgb(3 10 19 / 38%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 12%);
    backdrop-filter: blur(8px) saturate(112%);
  }

  .slider-ui button {
    pointer-events: auto;
  }

  .slide-count {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .slide-count [data-current-count] {
    color: var(--color-dawn);
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .count-rule {
    width: 2.5rem;
    height: 1px;
    background: var(--color-line-strong);
  }

  .slider-actions {
    display: flex;
    align-items: flex-end;
    gap: var(--space-6);
  }

  .slide-selectors {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
  }

  .slide-selectors button {
    max-width: 11rem;
    display: grid;
    gap: var(--space-2);
    border: 0;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: var(--step--1);
    text-align: left;
    background: transparent;
  }

  .selector-line {
    width: 2.4rem;
    height: 2px;
    background: var(--color-line-strong);
    transition: width var(--transition-base), background var(--transition-base);
  }

  .slide-selectors button.is-active {
    color: var(--color-text);
  }

  .slide-selectors button.is-active .selector-line {
    width: 4rem;
    background: var(--color-dawn);
  }

  .oled-constellation {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.18;
    transform: translate3d(0, 0, 0);
    transform-origin: 48% 52%;
    will-change: transform;
  }

  .slide.is-active .oled-constellation {
    animation: hero-constellation-drift 10.5s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite alternate;
  }

  .slide:nth-child(even).is-active .oled-constellation {
    animation-direction: alternate-reverse;
    animation-duration: 12s;
  }

  .oled-constellation-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .oled-constellation-lines polyline {
    fill: none;
    stroke: var(--color-moon);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 0.34;
  }

  .oled-constellation-lines .oled-constellation-branch {
    stroke: rgb(167 201 245 / 72%);
    stroke-dasharray: 1.2 1.1;
  }

  .oled-constellation span {
    position: absolute;
    width: 0.32rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-moon);
    box-shadow: 0 0 0.6rem var(--color-moon);
    transform: translate(-50%, -50%);
  }

  .oled-constellation span:nth-child(2) { top: 68%; left: 7%; }
  .oled-constellation span:nth-child(3) { top: 47%; left: 23%; background: var(--color-dawn); }
  .oled-constellation span:nth-child(4) { top: 55%; left: 42%; width: 0.42rem; }
  .oled-constellation span:nth-child(5) { top: 27%; left: 59%; }
  .oled-constellation span:nth-child(6) { top: 38%; left: 77%; background: var(--color-dawn); }
  .oled-constellation span:nth-child(7) { top: 17%; left: 92%; }
  .oled-constellation span:nth-child(8) { top: 79%; left: 53%; }
  .oled-constellation span:nth-child(9) { top: 67%; left: 70%; width: 0.26rem; }
  .oled-constellation span:nth-child(10) { top: 84%; left: 84%; }

  @keyframes hero-constellation-drift {
    0% {
      transform: translate3d(-0.9rem, -0.42rem, 0) rotate(-0.38deg) scale(1.004);
    }

    48% {
      transform: translate3d(0.18rem, 0.58rem, 0) rotate(0.12deg) scale(1.012);
    }

    100% {
      transform: translate3d(1.25rem, -0.18rem, 0) rotate(0.46deg) scale(1.02);
    }
  }

  @media (max-width: 58rem) {
    .slide-content {
      padding-bottom: 12rem;
    }

    .slider-actions {
      gap: var(--space-4);
    }

    .slide-selectors button span:last-child {
      display: none;
    }
  }

  @media (max-width: 46rem) {
    .project-slider {
      min-height: 100svh;
    }

    .slide-image {
      object-position: 62% center;
    }

    .slide:nth-child(2) .slide-image {
      object-position: 52% center;
    }

    .slide-shade {
      background: linear-gradient(180deg, rgb(3 10 19 / 8%) 28%, rgb(3 10 19 / 94%) 82%);
    }

    .slide-content {
      padding-block: calc(var(--header-height) + var(--space-6)) 12.5rem;
    }

    .slide-copy h1 {
      max-width: 11ch;
      font-size: clamp(1.8rem, 8.8vw, 2.52rem);
    }

    .slide-copy {
      padding: var(--space-5);
      backdrop-filter: blur(7px) saturate(112%);
    }

    .oled-constellation {
      opacity: 0.15;
    }

    .slide-copy p {
      max-width: 29rem;
      font-size: 1rem;
    }

    .project-cta {
      min-width: min(17rem, 100%);
    }

    .slider-ui {
      bottom: var(--space-5);
      align-items: center;
    }

    .slider-actions {
      align-items: center;
    }

    .slide-selectors {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oled-constellation {
      animation: none !important;
      transform: none;
    }
  }
</style>
