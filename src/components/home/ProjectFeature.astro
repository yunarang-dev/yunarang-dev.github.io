---
import ArrowLink from '../ui/ArrowLink.astro';

interface Props {
  slug: string;
  shortTitle: string;
  title: string;
  summary: string;
  role: string;
  technologies: string[];
  index: number;
  tone: 'warm' | 'cool';
}

const { slug, shortTitle, title, summary, role, technologies, index, tone } = Astro.props;
---

<article class:list={['project-feature', `project-feature--${tone}`]}>
  <div class="project-signal" aria-hidden="true">
    <span class="project-index">0{index}</span>
    <span class="project-code">{shortTitle}</span>
    <span class="signal-line"></span>
    <span class="signal-point"></span>
  </div>

  <div class="project-copy">
    <h3>{title}</h3>
    <p class="project-summary">{summary}</p>
    <dl>
      <div>
        <dt>Role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt>Tools</dt>
        <dd>{technologies.join(' · ')}</dd>
      </div>
    </dl>
    <ArrowLink href={`/projects/${slug}/`} tone={tone}>프로젝트 보기</ArrowLink>
  </div>
</article>

<style>
  .project-feature {
    min-height: 27rem;
    display: grid;
    grid-template-columns: minmax(14rem, 0.92fr) minmax(18rem, 1.08fr);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .project-feature + .project-feature {
    border-top: 0;
  }

  .project-signal {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    border-right: 1px solid var(--color-line);
    background:
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px),
      linear-gradient(145deg, rgb(130 174 255 / 10%), transparent 58%);
    background-size: 3rem 3rem, 3rem 3rem, auto;
  }

  .project-feature--warm .project-signal {
    background:
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px),
      linear-gradient(145deg, rgb(255 138 61 / 11%), transparent 58%);
    background-size: 3rem 3rem, 3rem 3rem, auto;
  }

  .project-index,
  .project-code {
    position: absolute;
    font-family: var(--font-mono);
  }

  .project-index {
    top: var(--space-5);
    left: var(--space-5);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .project-code {
    right: var(--space-5);
    bottom: var(--space-4);
    color: rgb(242 244 247 / 5%);
    font-size: clamp(5rem, 10vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 0.9;
  }

  .signal-line {
    position: absolute;
    top: 52%;
    left: 14%;
    width: 72%;
    height: 34%;
    border: 1px solid var(--color-moon);
    border-radius: 50%;
    opacity: 0.38;
    transform: rotate(-13deg);
  }

  .project-feature--warm .signal-line {
    border-color: var(--color-dawn);
  }

  .signal-point {
    position: absolute;
    top: 44%;
    left: 38%;
    width: 0.45rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-moon);
    box-shadow: 0 0 1rem rgb(130 174 255 / 55%);
  }

  .project-feature--warm .signal-point {
    background: var(--color-dawn);
    box-shadow: 0 0 1rem rgb(255 138 61 / 48%);
  }

  .project-copy {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4.5rem);
  }

  h3 {
    margin-bottom: var(--space-5);
  }

  .project-summary {
    max-width: 35rem;
    color: var(--color-text-soft);
  }

  dl {
    width: 100%;
    margin-block: var(--space-6);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  dl div {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  dl div:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  dt {
    color: var(--color-text-soft);
  }

  dd {
    margin: 0;
  }

  @media (min-width: 68rem) {
    .project-feature:nth-child(even) .project-signal {
      grid-column: 2;
      grid-row: 1;
      border-right: 0;
      border-left: 1px solid var(--color-line);
    }

    .project-feature:nth-child(even) .project-copy {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (max-width: 48rem) {
    .project-feature {
      grid-template-columns: 1fr;
    }

    .project-signal {
      min-height: 13rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .project-copy {
      padding: var(--space-6) var(--space-5) var(--space-7);
    }
  }
</style>
