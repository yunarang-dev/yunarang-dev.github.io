---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getProjectCopy } from '../../i18n/projects';

interface MainProject {
  id: string;
  role: string;
  technologies: string[];
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  projects: MainProject[];
}

const { projects } = Astro.props;
---

<section
  class="main-projects snap-section"
  id="main-projects"
  aria-labelledby="main-projects-title"
  data-project-navigator
>
  <div class="ambient-line ambient-line-a" aria-hidden="true"></div>
  <div class="ambient-line ambient-line-b" aria-hidden="true"></div>

  <div class="container project-layout">
    <div class="project-rail glass-pane">
      <h2 id="main-projects-title" data-i18n="home.projects.title">Main Projects</h2>
      <div class="project-tabs" role="tablist" aria-label="メインプロジェクト" data-i18n-aria="home.slider.label">
        {projects.map((project, index) => {
          const copy = getProjectCopy(project.id);
          return (
          <button
            type="button"
            role="tab"
            class:list={['project-tab', { 'is-active': index === 0 }]}
            id={'project-tab-' + index}
            aria-controls={'project-panel-' + index}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-project-tab={index}
          >
            <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="project-name" data-locale-ja={copy.ja.title} data-locale-ko={copy.ko.title}>{copy.ja.title}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13.5 6.5 19 12l-5.5 5.5" />
            </svg>
          </button>
          );
        })}
      </div>
    </div>

    <div class="project-panels glass-pane">
      <div class="constellation-path" aria-hidden="true">
        <svg class="constellation-lines" viewBox="0 0 100 100" preserveAspectRatio="none"><polyline points="0,10 44,32 70,64 90,78 75,92" /></svg>
        <span></span><span></span><span></span><span></span><span></span>
      </div>

      {projects.map((project, index) => {
        const copy = getProjectCopy(project.id);
        return (
        <article
          role="tabpanel"
          class:list={['project-panel', { 'is-active': index === 0 }]}
          id={'project-panel-' + index}
          aria-labelledby={'project-tab-' + index}
          hidden={index !== 0}
          data-project-panel
        >
          <div class="project-intro">
            <h3 data-locale-ja={copy.ja.title} data-locale-ko={copy.ko.title}>{copy.ja.title}</h3>
            <p data-locale-ja={copy.ja.summary} data-locale-ko={copy.ko.summary}>{copy.ja.summary}</p>
          </div>

          <dl class="project-meta">
            <div>
              <dt data-i18n="home.projects.role">Role</dt>
              <dd>{project.role}</dd>
            </div>
            <div>
              <dt data-i18n="home.projects.tools">Tools</dt>
              <dd>{project.technologies.join(' / ')}</dd>
            </div>
          </dl>

          <div class="project-media">
            <Image
              src={project.image}
              alt={project.imageAlt}
              widths={[640, 960, 1280]}
              sizes="(max-width: 48rem) 90vw, 52vw"
              format="webp"
              quality={84}
              loading="eager"
            />
          </div>

          <a class="detail-link" href={'/projects/' + project.id + '/'}>
            <span data-i18n="home.projects.open">プロジェクトページへ</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13.5 6.5 19 12l-5.5 5.5" />
            </svg>
          </a>
        </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-navigator]').forEach((navigator) => {
    const tabs = [...navigator.querySelectorAll<HTMLButtonElement>('[data-project-tab]')];
    const panels = [...navigator.querySelectorAll<HTMLElement>('[data-project-panel]')];

    const activate = (index: number, focus = false) => {
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.classList.toggle('is-active', selected);
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });

      panels.forEach((panel, panelIndex) => {
        const selected = panelIndex === index;
        panel.hidden = !selected;
        panel.classList.toggle('is-active', selected);
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowUp', 'ArrowDown', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        if (event.key === 'Home') activate(0, true);
        else if (event.key === 'End') activate(tabs.length - 1, true);
        else activate((index + (event.key === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length, true);
      });
    });
  });
</script>

<style>
  .main-projects {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    padding-block: var(--space-8);
    background: transparent;
  }

  .main-projects::before {
    position: absolute;
    inset: 0;
    background: var(--home-halo);
    background-attachment: fixed;
    background-position: center;
    background-size: 100vw 100svh;
    content: '';
    pointer-events: none;
  }

  .project-layout {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(20rem, 0.8fr) minmax(0, 1.35fr);
    gap: clamp(1rem, 2vw, 2rem);
  }

  .glass-pane {
    position: relative;
    border: 1px solid rgb(182 206 255 / 42%);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 6%), transparent 32%),
      rgb(8 24 41 / 52%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 14%),
      inset 1px 0 0 rgb(130 174 255 / 10%),
      0 2.2rem 6rem rgb(0 0 0 / 25%);
    backdrop-filter: blur(12px) saturate(118%);
  }

  .glass-pane::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: var(--home-glass-surface);
    content: '';
    pointer-events: none;
  }

  .glass-pane::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: var(--home-panel-reflection);
    background-attachment: fixed;
    background-position: center;
    background-size: 100vw 100svh;
    content: '';
    pointer-events: none;
  }

  .project-rail {
    min-height: min(47rem, calc(100svh - 7rem));
    padding: clamp(2rem, 4vw, 4rem) clamp(1.25rem, 3vw, 3.5rem);
  }

  .project-rail h2 {
    position: relative;
    z-index: 2;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-line-strong);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
  }

  .project-tabs {
    position: relative;
    z-index: 2;
    margin-top: var(--space-7);
  }

  .project-tab {
    width: 100%;
    min-height: 8rem;
    display: grid;
    align-items: center;
    grid-template-columns: 5rem 1fr 1.4rem;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4);
    border: 0;
    border-bottom: 1px solid var(--color-line-strong);
    color: var(--color-muted);
    text-align: left;
    background: transparent;
    transition:
      color var(--transition-base),
      background var(--transition-base),
      box-shadow var(--transition-base);
  }

  .project-tab.is-active {
    border: 1px solid var(--color-dawn);
    color: var(--color-dawn-soft);
    background: linear-gradient(90deg, rgb(255 138 61 / 13%), transparent);
    box-shadow:
      inset 3px 0 0 var(--color-dawn),
      0 0 1.2rem rgb(255 138 61 / 10%);
  }

  .project-number {
    font-family: var(--font-display);
    font-size: var(--step-3);
  }

  .project-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .project-tab svg,
  .detail-link svg {
    width: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.3;
  }

  .project-panels {
    min-height: min(47rem, calc(100svh - 7rem));
    padding: clamp(2rem, 4vw, 4rem);
  }

  .project-panel {
    position: relative;
    z-index: 2;
    animation: panel-reveal 420ms ease both;
  }

  .project-intro h3 {
    font-size: var(--step-3);
  }

  .project-intro h3::after {
    width: 4.5rem;
    height: 2px;
    display: block;
    margin-top: var(--space-5);
    background: var(--color-dawn);
    box-shadow: 0 0 0.75rem rgb(255 138 61 / 48%);
    content: '';
  }

  .project-intro p {
    max-width: 42rem;
    margin-top: var(--space-5);
    color: var(--color-text-soft);
    font-size: clamp(1rem, 1.25vw, 1.15rem);
  }

  .project-meta {
    margin-top: var(--space-6);
    border-top: 1px solid var(--color-line-strong);
  }

  .project-meta div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line-strong);
  }

  .project-meta dt {
    color: var(--color-moon);
    font-family: var(--font-display);
  }

  .project-meta dd {
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .project-media {
    position: relative;
    aspect-ratio: 16 / 6.2;
    margin-top: var(--space-5);
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
  }

  .project-media :global(picture),
  .project-media :global(img) {
    width: 100%;
    height: 100%;
  }

  .project-media :global(img) {
    object-fit: cover;
  }

  .detail-link {
    width: min(20rem, 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-5);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-dawn);
    color: var(--color-dawn);
    font-family: var(--font-ja);
    text-decoration: none;
  }

  .constellation-path {
    position: absolute;
    z-index: 1;
    top: 25%;
    left: -1.8rem;
    width: 8rem;
    height: 18rem;
    pointer-events: none;
    opacity: 0.3;
    transform: translate3d(var(--glass-shift-x, 0), var(--glass-shift-y, 0), 0);
    will-change: transform;
  }

  .constellation-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .constellation-lines polyline {
    fill: none;
    stroke: var(--color-moon);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 0.45;
  }

  .constellation-path span {
    position: absolute;
    width: 0.38rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-moon);
    box-shadow: 0 0 0.7rem var(--color-moon);
  }

  .constellation-path span:nth-child(2) { top: 10%; left: 0; background: var(--color-dawn); }
  .constellation-path span:nth-child(3) { top: 32%; left: 44%; }
  .constellation-path span:nth-child(4) { top: 64%; left: 70%; }
  .constellation-path span:nth-child(5) { top: 78%; left: 90%; }
  .constellation-path span:nth-child(6) { top: 92%; left: 75%; }

  .ambient-line {
    position: absolute;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(130 174 255 / 28%), transparent);
  }

  .ambient-line-a {
    top: 20%;
    left: -8%;
    width: 45%;
    transform: rotate(23deg);
  }

  .ambient-line-b {
    right: -12%;
    bottom: 18%;
    width: 48%;
    transform: rotate(-17deg);
  }

  @keyframes panel-reveal {
    from { opacity: 0; transform: translateY(0.7rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 62rem) {
    .project-layout {
      grid-template-columns: 0.8fr 1.2fr;
    }

    .project-rail,
    .project-panels {
      transform: none;
    }

    .project-tab {
      grid-template-columns: 4rem 1fr;
    }

    .project-tab svg {
      display: none;
    }
  }

  @media (max-width: 48rem) {
    .main-projects {
      min-height: auto;
      padding-block: var(--space-8);
    }

    .project-layout {
      grid-template-columns: 1fr;
    }

    .glass-pane {
      backdrop-filter: blur(8px);
    }

    .project-rail,
    .project-panels {
      min-height: auto;
    }

    .project-rail {
      padding: var(--space-5);
    }

    .project-tabs {
      margin-top: var(--space-5);
    }

    .project-tab {
      min-height: 5.5rem;
      grid-template-columns: 3.5rem 1fr 1.2rem;
    }

    .project-tab svg {
      display: block;
    }

    .project-number {
      font-size: var(--step-2);
    }

    .project-name {
      font-size: 1rem;
    }

    .project-panels {
      padding: var(--space-5);
    }

    .project-intro h3 {
      font-size: var(--step-2);
    }

    .project-intro p {
      font-size: 1rem;
    }

    .project-meta div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .project-media {
      aspect-ratio: 16 / 9;
    }

    .constellation-path {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .constellation-path {
      transform: none;
    }
  }
</style>
