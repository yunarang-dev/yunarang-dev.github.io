---
import { pageCopy } from '../../i18n/site';

const points = [
  { href: '#featured-projects', depth: 0, label: pageCopy.home.depth.surface },
  { href: '#main-projects', depth: 80, label: pageCopy.home.depth.projects },
  { href: '#recent-records', depth: 240, label: pageCopy.home.depth.records },
  { href: '#github-activity', depth: 480, label: pageCopy.home.depth.signals },
  { href: '#contact', depth: 720, label: pageCopy.home.depth.connection },
];
---

<nav
  class="depth-indicator"
  aria-label={pageCopy.home.depthAria.ja}
  data-locale-aria-ja={pageCopy.home.depthAria.ja}
  data-locale-aria-ko={pageCopy.home.depthAria.ko}
  data-depth-indicator
>
  <div class="depth-indicator__readout" aria-live="off">
    <span class="depth-indicator__label" data-depth-label>{points[0].label.ja}</span>
    <span class="depth-indicator__value"><strong data-depth-value>0</strong><small>m</small></span>
  </div>

  <ol class="depth-indicator__track">
    {points.map((point, index) => (
      <li>
        <a
          href={point.href}
          class:list={{ 'is-active': index === 0 }}
          aria-current={index === 0 ? 'location' : undefined}
          data-depth-point={point.depth}
          data-depth-label-ja={point.label.ja}
          data-depth-label-ko={point.label.ko}
        >
          <span class="depth-indicator__node" aria-hidden="true"></span>
          <span class="depth-indicator__point-copy">
            <span data-locale-ja={point.label.ja} data-locale-ko={point.label.ko}>{point.label.ja}</span>
            <small>{point.depth}m</small>
          </span>
        </a>
      </li>
    ))}
  </ol>
</nav>
