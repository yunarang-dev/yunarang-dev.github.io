---
import LocalizedText from '../ui/LocalizedText.astro';
import { wikiCategoryLabel, wikiCopy, type WikiCategory } from '../../data/project-wiki';

interface WikiLink {
  slug: string;
  title: { ja: string; ko: string };
  category: WikiCategory;
}

interface Props {
  projectSlug: string;
  articles: WikiLink[];
  currentArticle?: string;
}

const { projectSlug, articles, currentArticle } = Astro.props;
---

<nav
  class="project-wiki-nav"
  aria-label={wikiCopy.navigation.ja}
  data-locale-aria-ja={wikiCopy.navigation.ja}
  data-locale-aria-ko={wikiCopy.navigation.ko}
>
  <a class="project-wiki-nav__home" href={`/projects/${projectSlug}/`}>
    <span aria-hidden="true">←</span>
    <span><LocalizedText value={wikiCopy.projectHome} /></span>
  </a>

  <p class="project-wiki-nav__title"><LocalizedText value={wikiCopy.navigation} /></p>
  <ol>
    {articles.map((article, index) => (
      <li>
        <a
          href={`/projects/${projectSlug}/wiki/${article.slug}/`}
          aria-current={currentArticle === article.slug ? 'page' : undefined}
        >
          <span class="project-wiki-nav__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="project-wiki-nav__copy">
            <small>{wikiCategoryLabel[article.category]}</small>
            <LocalizedText value={article.title} />
          </span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .project-wiki-nav {
    color: var(--color-muted);
  }

  .project-wiki-nav__home {
    display: inline-flex;
    gap: var(--space-2);
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.075em;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .project-wiki-nav__home:hover {
    color: var(--color-dawn-soft);
  }

  .project-wiki-nav__title {
    margin-top: var(--space-7);
    color: var(--color-moon);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
  }

  ol {
    margin-top: var(--space-3);
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  li {
    border-bottom: 1px solid var(--color-line);
  }

  li a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-4);
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  li a:hover,
  li a[aria-current='page'] {
    color: var(--color-text);
  }

  li a[aria-current='page'] {
    background: linear-gradient(90deg, rgb(130 174 255 / 12%), transparent 82%);
  }

  .project-wiki-nav__number,
  small {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
  }

  .project-wiki-nav__number {
    color: var(--color-dawn-soft);
  }

  .project-wiki-nav__copy {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
    color: var(--color-text-soft);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  small {
    color: var(--color-muted);
  }

  @media (max-width: 62rem) {
    .project-wiki-nav__title {
      margin-top: 0;
    }

    ol {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      border-right: 1px solid var(--color-line);
    }

    li {
      border-right: 1px solid var(--color-line);
    }
  }
</style>
