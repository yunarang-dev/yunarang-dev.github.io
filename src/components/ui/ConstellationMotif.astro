---
interface Props {
  class?: string;
  variant: 'archive' | 'blog' | 'projects';
}

const { class: className, variant } = Astro.props;
---

<div class:list={['constellation-motif', className]} aria-hidden="true">
  {variant === 'blog' ? (
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      <polyline points="4,64 21,39 41,51 58,24 78,36 96,15" />
      <polyline class="constellation-motif__branch" points="41,51 53,79 72,68 88,83" />
      <circle cx="4" cy="64" r="1.1" />
      <circle cx="21" cy="39" r="1.45" />
      <circle cx="41" cy="51" r="1.2" />
      <circle cx="58" cy="24" r="1.65" />
      <circle cx="78" cy="36" r="1.2" />
      <circle cx="96" cy="15" r="1.1" />
      <circle cx="53" cy="79" r="1.25" />
      <circle cx="72" cy="68" r="1.1" />
      <circle cx="88" cy="83" r="0.95" />
    </svg>
  ) : variant === 'archive' ? (
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      <polyline points="48,4 31,22 52,39 30,58 54,77 40,97" />
      <polyline class="constellation-motif__branch" points="52,39 76,27 94,45" />
      <polyline class="constellation-motif__branch constellation-motif__branch--faint" points="30,58 13,72 25,88" />
      <circle cx="48" cy="4" r="1.35" />
      <circle cx="31" cy="22" r="1.1" />
      <circle cx="52" cy="39" r="1.65" />
      <circle cx="30" cy="58" r="1.15" />
      <circle cx="54" cy="77" r="1.3" />
      <circle cx="40" cy="97" r="1.05" />
      <circle cx="76" cy="27" r="1.15" />
      <circle cx="94" cy="45" r="1.1" />
      <circle cx="13" cy="72" r="0.9" />
      <circle cx="25" cy="88" r="1" />
    </svg>
  ) : (
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      <polyline points="18,16 47,8 72,29 61,57 84,84" />
      <polyline class="constellation-motif__branch" points="61,57 28,73 11,55" />
      <circle cx="18" cy="16" r="1.2" />
      <circle cx="47" cy="8" r="1.35" />
      <circle cx="72" cy="29" r="1.2" />
      <circle cx="61" cy="57" r="1.65" />
      <circle cx="84" cy="84" r="1.2" />
      <circle cx="28" cy="73" r="1.15" />
      <circle cx="11" cy="55" r="0.95" />
    </svg>
  )}
</div>

<style>
  .constellation-motif {
    position: absolute;
    z-index: 0;
    top: clamp(5.5rem, 10vw, 8rem);
    right: clamp(-4.5rem, -4vw, -1rem);
    width: clamp(12rem, 20vw, 18rem);
    aspect-ratio: 1.08;
    opacity: 0.5;
    pointer-events: none;
    transform-origin: 55% 48%;
    animation: constellation-motif-drift 13s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite alternate;
  }

  .constellation-motif--archive {
    top: clamp(5rem, 9vw, 7.25rem);
    width: clamp(13rem, 22vw, 20rem);
    animation-duration: 15s;
    animation-direction: alternate-reverse;
  }

  .constellation-motif--projects {
    top: clamp(5.5rem, 10vw, 8.5rem);
    right: clamp(-3.5rem, -2vw, -0.5rem);
    width: clamp(12.5rem, 20vw, 18.5rem);
    animation-duration: 12s;
  }

  .constellation-motif svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .constellation-motif polyline {
    fill: none;
    stroke: rgb(182 206 255 / 32%);
    stroke-width: 0.68;
    vector-effect: non-scaling-stroke;
  }

  .constellation-motif .constellation-motif__branch {
    stroke: rgb(255 177 125 / 20%);
    stroke-dasharray: 2.2 2.8;
  }

  .constellation-motif .constellation-motif__branch--faint {
    stroke: rgb(182 206 255 / 17%);
  }

  .constellation-motif circle {
    fill: rgb(182 206 255 / 82%);
    filter: drop-shadow(0 0 0.28rem rgb(130 174 255 / 55%));
  }

  .constellation-motif circle:nth-of-type(4) {
    fill: rgb(255 177 125 / 86%);
    filter: drop-shadow(0 0 0.34rem rgb(255 138 61 / 58%));
  }

  @keyframes constellation-motif-drift {
    0% { transform: translate3d(-0.35rem, -0.2rem, 0) rotate(-0.3deg); }
    52% { transform: translate3d(0.2rem, 0.34rem, 0) rotate(0.12deg); }
    100% { transform: translate3d(0.75rem, -0.08rem, 0) rotate(0.45deg); }
  }

  @media (max-width: 44rem) {
    .constellation-motif {
      top: 7.25rem;
      right: -4.8rem;
      width: 11rem;
      opacity: 0.28;
    }

    .constellation-motif--archive {
      top: 6.75rem;
      width: 11.5rem;
    }

    .constellation-motif--projects {
      top: 6.75rem;
      right: -4.1rem;
      width: 11.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .constellation-motif {
      animation: none;
      transform: none;
    }
  }
</style>
