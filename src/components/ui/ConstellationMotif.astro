---
interface Props {
  class?: string;
  variant: 'archive' | 'blog' | 'projects';
}

const { class: className, variant } = Astro.props;
---

<div class:list={['constellation-motif', className]} aria-hidden="true">
  {variant === 'blog' ? (
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      <polyline points="5,60 23,37 42,52 60,28 82,43 96,20" />
      <polyline class="constellation-motif__branch" points="42,52 55,77 73,73" />
      <circle cx="5" cy="60" r="1.1" />
      <circle cx="23" cy="37" r="1.45" />
      <circle cx="42" cy="52" r="1.2" />
      <circle cx="60" cy="28" r="1.65" />
      <circle cx="82" cy="43" r="1.2" />
      <circle cx="96" cy="20" r="1.1" />
      <circle cx="55" cy="77" r="1.25" />
      <circle cx="73" cy="73" r="1.1" />
    </svg>
  ) : variant === 'archive' ? (
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      <polyline points="53,6 35,25 55,43 36,62 56,80 43,96" />
      <polyline class="constellation-motif__branch" points="55,43 80,32 92,49" />
      <circle cx="53" cy="6" r="1.35" />
      <circle cx="35" cy="25" r="1.1" />
      <circle cx="55" cy="43" r="1.65" />
      <circle cx="36" cy="62" r="1.15" />
      <circle cx="56" cy="80" r="1.3" />
      <circle cx="43" cy="96" r="1.05" />
      <circle cx="80" cy="32" r="1.15" />
      <circle cx="92" cy="49" r="1.1" />
    </svg>
  ) : (
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      <polyline points="31,10 65,27 55,58 79,88" />
      <polyline class="constellation-motif__branch" points="55,58 17,73 31,10" />
      <circle cx="31" cy="10" r="1.35" />
      <circle cx="65" cy="27" r="1.2" />
      <circle cx="55" cy="58" r="1.65" />
      <circle cx="79" cy="88" r="1.2" />
      <circle cx="17" cy="73" r="1.15" />
    </svg>
  )}
</div>

<style>
  .constellation-motif {
    position: absolute;
    z-index: 0;
    top: clamp(5.5rem, 10vw, 8rem);
    right: clamp(-4.5rem, -4vw, -1rem);
    width: clamp(12rem, 20vw, 18rem);
    aspect-ratio: 1.08;
    opacity: 0.5;
    pointer-events: none;
  }

  .constellation-motif--archive {
    top: clamp(5rem, 9vw, 7.25rem);
    width: clamp(13rem, 22vw, 20rem);
  }

  .constellation-motif--projects {
    top: clamp(5.5rem, 10vw, 8.5rem);
    right: clamp(-3.5rem, -2vw, -0.5rem);
    width: clamp(12.5rem, 20vw, 18.5rem);
  }

  .constellation-motif svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .constellation-motif polyline {
    fill: none;
    stroke: rgb(182 206 255 / 32%);
    stroke-width: 0.68;
    vector-effect: non-scaling-stroke;
  }

  .constellation-motif .constellation-motif__branch {
    stroke: rgb(255 177 125 / 20%);
  }

  .constellation-motif circle {
    fill: rgb(182 206 255 / 82%);
    filter: drop-shadow(0 0 0.28rem rgb(130 174 255 / 55%));
  }

  .constellation-motif circle:nth-of-type(4) {
    fill: rgb(255 177 125 / 86%);
    filter: drop-shadow(0 0 0.34rem rgb(255 138 61 / 58%));
  }

  @media (max-width: 44rem) {
    .constellation-motif {
      top: 7.25rem;
      right: -4.8rem;
      width: 11rem;
      opacity: 0.28;
    }

    .constellation-motif--archive {
      top: 6.75rem;
      width: 11.5rem;
    }

    .constellation-motif--projects {
      top: 6.75rem;
      right: -4.1rem;
      width: 11.5rem;
    }
  }
</style>
