---
import type { LocalizedTextValue } from '../../i18n/markup';
import LocalizedText from '../ui/LocalizedText.astro';

interface Props {
  title: LocalizedTextValue;
  description: LocalizedTextValue;
}

const { title, description } = Astro.props;
---

<section class="placeholder-page content-container" data-scroll-reveal>
  <LocalizedText as="h1" value={title} />
  <LocalizedText as="p" value={description} />
</section>
