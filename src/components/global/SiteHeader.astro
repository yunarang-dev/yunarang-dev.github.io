---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { messages, pageCopy, type MessageKey } from '../../i18n/site';

const pathname = Astro.url.pathname;
interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const links = [
  { href: '/', key: 'nav.home' },
  { href: '/blog/', key: 'nav.blog' },
  { href: '/projects/', key: 'nav.projects' },
  { href: '/wiki/', key: 'nav.wiki' },
  { href: '/archive/', key: 'nav.archive' },
  { href: '/about/', key: 'nav.about' },
] satisfies Array<{ href: string; key: MessageKey }>;

const isCurrent = (href: string) => {
  if (href === '/') return pathname === href;
  if (href === '/wiki/') return pathname === href || pathname.includes('/wiki/');
  if (href === '/projects/') return pathname.startsWith(href) && !pathname.includes('/wiki/');
  return pathname.startsWith(href);
};
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="container header-inner">
    <a
      class="wordmark"
      href="/"
      aria-label={pageCopy.site.homeAria.ja}
      data-locale-aria-ja={pageCopy.site.homeAria.ja}
      data-locale-aria-ko={pageCopy.site.homeAria.ko}
    >{pageCopy.site.wordmark.ja}</a>

    <div class="header-actions">
      <nav class="desktop-nav" aria-label={messages.ja['nav.label']} data-i18n-aria="nav.label">
        <ul>
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                data-i18n={link.key}
              >
                {messages.ja[link.key]}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <LanguageSwitcher />

      <details class="mobile-nav">
        <summary data-i18n="nav.mobile-label">{messages.ja['nav.mobile-label']}</summary>
        <nav aria-label={messages.ja['nav.label']} data-i18n-aria="nav.label">
          <ul>
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  data-i18n={link.key}
                >
                  {messages.ja[link.key]}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-line);
    background:
      linear-gradient(115deg, rgb(130 174 255 / 5%), transparent 34%, rgb(255 138 61 / 3%) 74%, transparent),
      rgb(3 10 19 / 68%);
    box-shadow:
      inset 0 1px 0 rgb(226 239 255 / 7%),
      0 0.6rem 2rem rgb(0 4 10 / 14%);
    backdrop-filter: blur(18px) saturate(132%);
    -webkit-backdrop-filter: blur(18px) saturate(132%);
  }

  .site-header::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 4%,
      rgb(205 228 255 / 3%) 38%,
      rgb(205 228 255 / 7%) 50%,
      transparent 66%
    );
    content: '';
    pointer-events: none;
  }

  .site-header--overlay {
    position: absolute;
    inset: 0 0 auto;
    border-bottom-color: rgb(205 228 255 / 15%);
    background:
      linear-gradient(115deg, rgb(130 174 255 / 5%), transparent 38%, rgb(255 138 61 / 2%) 78%, transparent),
      linear-gradient(180deg, rgb(3 10 19 / 62%), rgb(3 10 19 / 28%));
    box-shadow:
      inset 0 1px 0 rgb(226 239 255 / 7%),
      0 0.8rem 2.4rem rgb(0 4 10 / 10%);
    backdrop-filter: blur(16px) saturate(128%);
    -webkit-backdrop-filter: blur(16px) saturate(128%);
  }

  .header-inner {
    position: relative;
    z-index: 1;
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .wordmark {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.28em;
    text-decoration: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 1.6vw, 1.35rem);
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.7vw, 2.8rem);
    list-style: none;
  }

  nav a,
  summary {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-dawn);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 1.55rem;
  }

  .mobile-nav {
    display: none;
    position: relative;
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  @media (max-width: 56rem) {
    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }

    .header-actions {
      gap: var(--space-3);
    }

    .mobile-nav nav {
      position: absolute;
      top: calc(100% + 1rem);
      right: 0;
      width: min(16rem, calc(100vw - (var(--gutter) * 2)));
      padding: var(--space-5);
      border: 1px solid var(--color-line-strong);
      border-radius: var(--radius-md);
      background:
        linear-gradient(135deg, rgb(130 174 255 / 7%), transparent 42%),
        rgb(8 22 37 / 88%);
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(18px) saturate(130%);
      -webkit-backdrop-filter: blur(18px) saturate(130%);
    }

    .mobile-nav ul {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
    }

    .mobile-nav a {
      display: block;
      padding-block: var(--space-3);
    }

    .mobile-nav a[aria-current='page'] {
      text-decoration: none;
    }
  }
</style>
