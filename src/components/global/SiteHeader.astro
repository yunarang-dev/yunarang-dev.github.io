---
import LanguageSwitcher from './LanguageSwitcher.astro';

const pathname = Astro.url.pathname;
interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const links = [
  { href: '/', label: 'Home', key: 'nav.home' },
  { href: '/blog/', label: 'Blog', key: 'nav.blog' },
  { href: '/projects/', label: 'Projects', key: 'nav.projects' },
  { href: '/wiki/', label: 'Wiki', key: 'nav.wiki' },
  { href: '/archive/', label: 'Archive', key: 'nav.archive' },
  { href: '/about/', label: 'About', key: 'nav.about' },
];

const isCurrent = (href: string) => {
  if (href === '/') return pathname === href;
  if (href === '/wiki/') return pathname === href || pathname.includes('/wiki/');
  if (href === '/projects/') return pathname.startsWith(href) && !pathname.includes('/wiki/');
  return pathname.startsWith(href);
};
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="Yunarang home">YUNARANG</a>

    <div class="header-actions">
      <nav class="desktop-nav" aria-label="メインナビゲーション" data-i18n-aria="nav.label">
        <ul>
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                data-i18n={link.key}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <LanguageSwitcher />

      <details class="mobile-nav">
        <summary data-i18n="nav.mobile-label">メニュー</summary>
        <nav aria-label="モバイルナビゲーション" data-i18n-aria="nav.label">
          <ul>
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  data-i18n={link.key}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-line);
    background: rgb(3 10 19 / 76%);
    backdrop-filter: blur(12px);
  }

  .site-header--overlay {
    position: absolute;
    inset: 0 0 auto;
    border-bottom-color: rgb(242 244 247 / 12%);
    background: linear-gradient(180deg, rgb(3 10 19 / 72%), transparent);
    backdrop-filter: none;
  }

  .header-inner {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .wordmark {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.28em;
    text-decoration: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 1.6vw, 1.35rem);
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.7vw, 2.8rem);
    list-style: none;
  }

  nav a,
  summary {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-dawn);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 1.55rem;
  }

  .mobile-nav {
    display: none;
    position: relative;
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  @media (max-width: 56rem) {
    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }

    .header-actions {
      gap: var(--space-3);
    }

    .mobile-nav nav {
      position: absolute;
      top: calc(100% + 1rem);
      right: 0;
      width: min(16rem, calc(100vw - (var(--gutter) * 2)));
      padding: var(--space-5);
      border: 1px solid var(--color-line-strong);
      border-radius: var(--radius-md);
      background: var(--color-surface-strong);
      box-shadow: var(--shadow-soft);
    }

    .mobile-nav ul {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
    }

    .mobile-nav a {
      display: block;
      padding-block: var(--space-3);
    }

    .mobile-nav a[aria-current='page'] {
      text-decoration: none;
    }
  }
</style>
