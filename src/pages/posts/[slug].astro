---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { formatMessagePair, messages, pageCopy, postRedirects, type PostRedirect } from '../../i18n/site';
import LocalizedText from '../../components/ui/LocalizedText.astro';
import PlaceholderPage from '../../components/global/PlaceholderPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/post.css';

interface Props {
  route?: PostRedirect;
  post?: CollectionEntry<'posts'>;
  redirectTo?: string;
}

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const contentSlugs = new Set(posts.map((post) => post.data.slug));
  const redirects = postRedirects.filter((route) => !contentSlugs.has(route.slug));

  return [
    ...posts.map((post) => ({
      params: { slug: post.data.slug },
      props: { post },
    })),
    ...redirects.map((route) => ({
      params: { slug: route.slug },
      props: { route, redirectTo: route.redirectTo },
    })),
  ];
}

const { route, post, redirectTo } = Astro.props as Props;

if (!post && !route) {
  throw new Error('A post route requires either a post or a redirect record.');
}

const renderedPost = post ? await render(post) : undefined;
const Content = renderedPost?.Content;
const date = post?.data.date;
const dateJa = date ? new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long' }).format(date) : '';
const dateKo = date ? new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long' }).format(date) : '';
const chronologicalPosts = post
  ? (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  : [];
const currentPostIndex = post ? chronologicalPosts.findIndex((candidate) => candidate.id === post.id) : -1;
const newerPost = currentPostIndex > 0 ? chronologicalPosts[currentPostIndex - 1] : undefined;
const olderPost = currentPostIndex >= 0 ? chronologicalPosts[currentPostIndex + 1] : undefined;
const relatedPosts = post
  ? chronologicalPosts
      .filter((candidate) => candidate.id !== post.id)
      .map((candidate) => ({
        post: candidate,
        score: Number(candidate.data.project?.id === post.data.project?.id && Boolean(post.data.project)) * 2
          + Number(candidate.data.category.ja === post.data.category.ja),
      }))
      .filter((candidate) => candidate.score > 0)
      .sort((a, b) => b.score - a.score || b.post.data.date.getTime() - a.post.data.date.getTime())
      .slice(0, 3)
      .map((candidate) => candidate.post)
  : [];
const formatDate = (value: Date, locale: 'ja-JP' | 'ko-KR') =>
  new Intl.DateTimeFormat(locale, { timeZone: 'Asia/Seoul', year: 'numeric', month: 'short', day: 'numeric' }).format(value);
const site = Astro.site ?? Astro.url;
const postUrl = post ? new URL(`/posts/${post.data.slug}/`, site).href : undefined;
const postSchema = post && postUrl
  ? {
      '@type': 'BlogPosting',
      '@id': `${postUrl}#article`,
      headline: post.data.title.ja,
      alternativeHeadline: post.data.title.ko,
      description: post.data.description?.ja ?? pageCopy.post.fallbackDescription.ja,
      image: [new URL(post.data.image?.src ?? '/social/yunarang-archive.png', site).href],
      datePublished: post.data.date.toISOString(),
      dateModified: (post.data.updated ?? post.data.date).toISOString(),
      inLanguage: ['ja', 'ko'],
      articleSection: post.data.category.ja,
      keywords: post.data.tags.map((tag) => tag.ja).join(', '),
      mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
      author: { '@id': `${new URL('/', site).href}#yunarang` },
      publisher: { '@id': `${new URL('/', site).href}#yunarang` },
      isPartOf: { '@id': `${new URL('/', site).href}#website` },
    }
  : undefined;
const postPageTitleJa = post ? formatMessagePair('site.title-template', { title: post.data.title.ja }) : undefined;
const postPageTitleKo = post ? formatMessagePair('site.title-template', { title: post.data.title.ko }) : undefined;
const redirectPageTitle = route ? formatMessagePair('site.title-template', { title: route.title }) : undefined;
---

{post && Content ? (
  <BaseLayout
    title={postPageTitleJa!.ja}
    titleKo={postPageTitleKo!.ko}
    description={post.data.description?.ja}
    descriptionKo={post.data.description?.ko}
    image={post.data.image?.src}
    imageAlt={post.data.image?.alt}
    type="article"
    publishedTime={post.data.date}
    modifiedTime={post.data.updated ?? post.data.date}
    structuredData={postSchema}
  >
    <article class="post-page">
      <header class="post-header content-container">
        <a class="post-back" href="/blog/">
          <span aria-hidden="true">←</span>
          <span data-i18n="post.back">{messages.ja['post.back']}</span>
        </a>
        <div class="post-kicker">
          <LocalizedText value={post.data.category} />
          <span aria-hidden="true">·</span>
          <time datetime={post.data.date.toISOString()} data-locale-ja={dateJa} data-locale-ko={dateKo}>{dateJa}</time>
        </div>
        <LocalizedText as="h1" value={post.data.title} />
        {post.data.description && <LocalizedText as="p" class="post-description" value={post.data.description} />}
        {post.data.tags.length > 0 && <ul class="post-tags" aria-label={messages.ja['common.tags']} data-i18n-aria="common.tags">{post.data.tags.map((tag) => <li><LocalizedText value={tag} /></li>)}</ul>}
      </header>

      {post.data.image && (
        <figure class="post-cover content-container">
          <img src={post.data.image.src} alt={post.data.image.alt} loading="eager" />
        </figure>
      )}

      <div class="post-layout content-container">
        <div class="post-reading">
          <div class="post-body markdown-content"><Content /></div>

          {(newerPost || olderPost) && (
            <nav class="post-navigation" aria-label={messages.ja['post.navigation']} data-i18n-aria="post.navigation">
              {newerPost ? (
                <a class="post-navigation__item post-navigation__item--newer" href={`/posts/${newerPost.data.slug}/`}>
                  <span class="post-navigation__label" data-i18n="post.newer">{messages.ja['post.newer']}</span>
                  <LocalizedText as="span" value={newerPost.data.title} />
                </a>
              ) : <span></span>}
              {olderPost ? (
                <a class="post-navigation__item post-navigation__item--older" href={`/posts/${olderPost.data.slug}/`}>
                  <span class="post-navigation__label" data-i18n="post.older">{messages.ja['post.older']}</span>
                  <LocalizedText as="span" value={olderPost.data.title} />
                </a>
              ) : <span></span>}
            </nav>
          )}
        </div>

        <aside class="post-toc" data-post-toc hidden>
          <p data-i18n="post.toc">{messages.ja['post.toc']}</p>
          <nav aria-label={messages.ja['post.toc']} data-i18n-aria="post.toc"><ol data-post-toc-list></ol></nav>
        </aside>
      </div>

      <details class="post-toc-mobile content-container" data-post-toc hidden>
        <summary data-i18n="post.toc">{messages.ja['post.toc']}</summary>
        <nav aria-label={messages.ja['post.toc']} data-i18n-aria="post.toc"><ol data-post-toc-list></ol></nav>
      </details>

      {relatedPosts.length > 0 && (
        <section class="post-related content-container" aria-labelledby="related-records-title">
          <div class="post-related__heading">
            <p data-i18n="post.related">{messages.ja['post.related']}</p>
            <p data-i18n="post.related.copy">{messages.ja['post.related.copy']}</p>
          </div>
          <h2 id="related-records-title" class="sr-only" data-i18n="post.related">{messages.ja['post.related']}</h2>
          <ol>
            {relatedPosts.map((relatedPost) => {
              const relatedDateJa = formatDate(relatedPost.data.date, 'ja-JP');
              const relatedDateKo = formatDate(relatedPost.data.date, 'ko-KR');
              const relatedLabelJa = formatMessagePair('common.read-title', { title: relatedPost.data.title.ja });
              const relatedLabelKo = formatMessagePair('common.read-title', { title: relatedPost.data.title.ko });
              return (
                <li>
                  <time datetime={relatedPost.data.date.toISOString()} data-locale-ja={relatedDateJa} data-locale-ko={relatedDateKo}>{relatedDateJa}</time>
                  <div>
                    <LocalizedText as="p" value={relatedPost.data.category} />
                    <h3><a href={`/posts/${relatedPost.data.slug}/`}><LocalizedText value={relatedPost.data.title} /></a></h3>
                  </div>
                  <a
                    href={`/posts/${relatedPost.data.slug}/`}
                    aria-label={relatedLabelJa.ja}
                    data-locale-aria-ja={relatedLabelJa.ja}
                    data-locale-aria-ko={relatedLabelKo.ko}
                  ><span aria-hidden="true">↗</span></a>
                </li>
              );
            })}
          </ol>
        </section>
      )}
    </article>

    <script>
      const root = document.documentElement;
      const tocLists = Array.from(document.querySelectorAll<HTMLOListElement>('[data-post-toc-list]'));
      const tocRegions = Array.from(document.querySelectorAll<HTMLElement>('[data-post-toc]'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let visibleHeadings: HTMLElement[] = [];

      const sectionIdForHeading = (headingId: string) => {
        let sectionId = '';

        for (const heading of visibleHeadings) {
          if (heading.tagName === 'H2') sectionId = heading.id;
          if (heading.id === headingId) return sectionId;
        }

        return sectionId;
      };

      const setSublistExpanded = (sublist: HTMLOListElement, isExpanded: boolean) => {
        const wasExpanded = sublist.dataset.tocExpanded === 'true';
        if (wasExpanded === isExpanded) return;

        const startHeight = sublist.hidden ? 0 : sublist.getBoundingClientRect().height;
        const startOpacity = sublist.hidden ? 0 : Number.parseFloat(getComputedStyle(sublist).opacity);
        sublist.dataset.tocExpanded = String(isExpanded);
        sublist.getAnimations().forEach((animation) => animation.cancel());

        if (reducedMotion.matches) {
          sublist.hidden = !isExpanded;
          return;
        }

        if (isExpanded) {
          sublist.hidden = false;
          const targetHeight = sublist.scrollHeight;
          sublist.animate(
            [
              { height: `${startHeight}px`, opacity: startOpacity },
              { height: `${targetHeight}px`, opacity: 1 },
            ],
            { duration: 300, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          );
          return;
        }

        const animation = sublist.animate(
          [
            { height: `${startHeight}px`, opacity: startOpacity },
            { height: '0px', opacity: 0 },
          ],
          { duration: 240, easing: 'cubic-bezier(0.4, 0, 0.6, 1)' },
        );

        animation.finished
          .then(() => {
            if (sublist.dataset.tocExpanded === 'false') sublist.hidden = true;
          })
          .catch(() => undefined);
      };

      const setActiveTableOfContents = (headingId: string) => {
        const activeSectionId = sectionIdForHeading(headingId);

        tocLists.forEach((list) => {
          list.querySelectorAll<HTMLAnchorElement>('a[data-toc-target]').forEach((link) => {
            const isActive = link.dataset.tocTarget === headingId;
            link.className = isActive ? 'is-active' : '';
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });

          list.querySelectorAll<HTMLOListElement>('[data-toc-sublist]').forEach((sublist) => {
            const isExpanded = sublist.dataset.tocSection === activeSectionId;
            setSublistExpanded(sublist, isExpanded);

            const sectionLink = Array.from(list.querySelectorAll<HTMLAnchorElement>('a[data-toc-target]')).find(
              (link) => link.dataset.tocTarget === sublist.dataset.tocSection,
            );
            sectionLink?.setAttribute('aria-expanded', String(isExpanded));
          });
        });
      };

      const updateActiveTableOfContents = () => {
        if (visibleHeadings.length === 0) return;

        const activationLine = Math.min(Math.max(window.innerHeight * 0.3, 140), 260);
        const activeHeading = visibleHeadings.reduce(
          (current, heading) => heading.getBoundingClientRect().top <= activationLine ? heading : current,
          visibleHeadings[0],
        );

        setActiveTableOfContents(activeHeading.id);
      };

      const updateTableOfContents = () => {
        visibleHeadings = Array.from(document.querySelectorAll<HTMLElement>('.post-body :is(h2, h3)')).filter((heading) => {
          const localeContent = heading.closest<HTMLElement>('[data-content-locale]');
          return !localeContent || localeContent.dataset.contentLocale === root.dataset.locale;
        });

        tocRegions.forEach((region) => {
          region.hidden = visibleHeadings.length === 0;
        });

        tocLists.forEach((list) => {
          list.replaceChildren();
          let currentSectionItem: HTMLLIElement | undefined;
          let currentSublist: HTMLOListElement | undefined;

          visibleHeadings.forEach((heading) => {
            if (!heading.id) return;

            const item = document.createElement('li');
            const link = document.createElement('a');
            link.href = `#${heading.id}`;
            link.dataset.tocTarget = heading.id;
            link.textContent = heading.textContent?.trim() ?? '';
            link.addEventListener('click', () => {
              setActiveTableOfContents(heading.id);
            });
            item.append(link);

            if (heading.tagName === 'H2') {
              item.className = 'is-section';
              list.append(item);
              currentSectionItem = item;
              currentSublist = undefined;
              return;
            }

            item.className = 'is-subheading';

            if (!currentSectionItem) {
              list.append(item);
              return;
            }

            if (!currentSublist) {
              currentSublist = document.createElement('ol');
              currentSublist.className = 'toc-sublist';
              currentSublist.dataset.tocSublist = '';
              currentSublist.dataset.tocSection = currentSectionItem.querySelector<HTMLAnchorElement>('a')?.dataset.tocTarget ?? '';
              currentSublist.dataset.tocExpanded = 'false';
              currentSublist.hidden = true;
              currentSectionItem.querySelector<HTMLAnchorElement>('a')?.setAttribute('aria-expanded', 'false');
              currentSectionItem.append(currentSublist);
            }

            currentSublist.append(item);
          });
        });

        updateActiveTableOfContents();
      };

      updateTableOfContents();
      document.addEventListener('site:localechange', updateTableOfContents);
      window.addEventListener('scroll', updateActiveTableOfContents, { passive: true });
      window.addEventListener('resize', updateActiveTableOfContents, { passive: true });
      window.addEventListener('hashchange', updateActiveTableOfContents);
    </script>
  </BaseLayout>
) : (
  <BaseLayout title={redirectPageTitle!.ja} titleKo={redirectPageTitle!.ko} redirectTo={redirectTo} noindex>
    <PlaceholderPage
      title={{ ja: route!.title, ko: route!.title }}
      description={{
        ja: `${route!.date} · ${(redirectTo ? pageCopy.post.redirectProject : pageCopy.post.redirectPost).ja}`,
        ko: `${route!.date} · ${(redirectTo ? pageCopy.post.redirectProject : pageCopy.post.redirectPost).ko}`,
      }}
    />
  </BaseLayout>
)}
