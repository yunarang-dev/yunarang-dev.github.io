---
import { getCollection } from 'astro:content';
import DeepSeaField from '../components/home/DeepSeaField.astro';
import MainProjectNavigator from '../components/home/MainProjectNavigator.astro';
import ProjectSlider from '../components/home/ProjectSlider.astro';
import DepthIndicator from '../components/home/DepthIndicator.astro';
import HeroBorderTrace from '../components/ui/HeroBorderTrace.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import LocalizedText from '../components/ui/LocalizedText.astro';
import type { LocalizedTextValue } from '../i18n/markup';
import { githubActivityCopy, messages, pageCopy, projectHeroImages } from '../i18n/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured && project.data.heroImage && project.data.heroAlt)
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => ({
    id: project.id,
    role: project.data.role,
    technologies: project.data.technologies,
    image: project.data.heroImage!,
    imageAlt: project.data.heroAlt!,
  }));

/**
 * The homepage is the visual entry point of the archive. Keep its two primary
 * project slides available while Astro refreshes Content Collection data in a
 * development session; normal builds and synced collections still use the
 * project Markdown metadata above.
 */
const primaryProjectFallback = [
  {
    id: 'astral-days',
    role: 'Direction · Narrative · Client Development',
    technologies: ['Unity', 'C#', 'Narrative Design'],
    image: projectHeroImages['astral-days'].image,
    imageAlt: projectHeroImages['astral-days'].imageAlt,
  },
  {
    id: 'project-vx',
    role: 'Game Systems · AI Workflow · Direction',
    technologies: ['Unity', 'C#', 'AI Agents'],
    image: projectHeroImages['project-vx'].image,
    imageAlt: projectHeroImages['project-vx'].imageAlt,
  },
];

const homeProjects = featuredProjects.length >= 2 ? featuredProjects : primaryProjectFallback;
const homeHeroProjects = homeProjects.map((project) => {
  const hero = projectHeroImages[project.id as keyof typeof projectHeroImages];
  return hero ? { ...project, ...hero } : project;
});

const timeZone = 'Asia/Seoul';
const formatDate = (date: Date, locale: 'ja-JP' | 'ko-KR') =>
  new Intl.DateTimeFormat(locale, {
    timeZone,
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

/**
 * A development log belongs to a project or explicitly carries the DevLog
 * tag. Everything else is a general archive entry, keeping the two Home
 * lists distinct while allowing ordinary Markdown front matter to drive both.
 */
const isDevelopmentLog = (post: (typeof allPosts)[number]) =>
  Boolean(post.data.project) || post.data.tags.some((tag) => tag.ja === 'DevLog');

const toHomeRecord = (post: (typeof allPosts)[number]) => ({
  ...post,
  dateJa: formatDate(post.data.date, 'ja-JP'),
  dateKo: formatDate(post.data.date, 'ko-KR'),
});

const developmentLogs = allPosts.filter(isDevelopmentLog).slice(0, 3).map(toHomeRecord);
const recentPosts = allPosts.filter((post) => !isDevelopmentLog(post)).slice(0, 4).map(toHomeRecord);

interface GitHubEvent {
  id: string;
  type: string;
  repo: { name: string };
  created_at: string;
  payload?: {
    action?: string;
    ref?: string;
    pull_request?: { html_url?: string; number?: number };
    issue?: { html_url?: string; number?: number };
  };
}

interface ActivityItem {
  id: string;
  date: string;
  dateTime: string;
  label: LocalizedTextValue;
  repository: string;
  href: string;
}

const fallbackGitHubActivity: ActivityItem[] = [
  {
    id: 'fallback-2026-08-26',
    date: '2026/08/27 07:50',
    dateTime: '2026-08-26T22:50:06Z',
    label: githubActivityCopy.push('main'),
    repository: 'yunarang-dev/yunarang-dev.github.io',
    href: 'https://github.com/yunarang-dev/yunarang-dev.github.io',
  },
];

const eventLabel = (event: GitHubEvent) => {
  const branch = event.payload?.ref?.replace('refs/heads/', '');
  if (event.type === 'PushEvent') return githubActivityCopy.push(branch ?? githubActivityCopy.repository.ja);
  if (event.type === 'PullRequestEvent') {
    return githubActivityCopy.pullRequest(
      event.payload?.action === 'closed',
      event.payload?.pull_request?.number ?? '',
    );
  }
  if (event.type === 'IssuesEvent') {
    return githubActivityCopy.issue(
      event.payload?.action === 'closed',
      event.payload?.issue?.number ?? '',
    );
  }
  if (event.type === 'CreateEvent') return githubActivityCopy.create;
  if (event.type === 'ReleaseEvent') return githubActivityCopy.release;
  const eventName = event.type.replace('Event', '');
  return { ja: eventName, ko: eventName };
};

const fetchGitHubActivity = async (): Promise<ActivityItem[]> => {
  try {
    const response = await fetch('https://api.github.com/users/yunarang-dev/events/public?per_page=12', {
      headers: {
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2026-03-10',
      },
      signal: AbortSignal.timeout(3500),
    });
    if (!response.ok) return fallbackGitHubActivity;

    const events = (await response.json()) as GitHubEvent[];
    const seen = new Set<string>();
    const activity = events.flatMap((event) => {
      const key = [event.type, event.repo.name, event.payload?.ref ?? event.payload?.action ?? ''].join(':');
      if (seen.has(key)) return [];
      seen.add(key);
      return [{
        id: event.id,
        date: new Intl.DateTimeFormat('ja-JP', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
        }).format(new Date(event.created_at)),
        dateTime: event.created_at,
        label: eventLabel(event),
        repository: event.repo.name,
        href:
          event.payload?.pull_request?.html_url ??
          event.payload?.issue?.html_url ??
          'https://github.com/' + event.repo.name,
      }];
    });
    return activity.slice(0, 5).length > 0 ? activity.slice(0, 5) : fallbackGitHubActivity;
  } catch {
    return fallbackGitHubActivity;
  }
};

const githubActivity = await fetchGitHubActivity();
---

<BaseLayout
  title={pageCopy.home.metaTitle.ja}
  titleKo={pageCopy.home.metaTitle.ko}
  description={pageCopy.home.metaDescription.ja}
  descriptionKo={pageCopy.home.metaDescription.ko}
  pageClass="home-scroll"
  overlayHeader
>
  <div class="home-refraction-layer" aria-hidden="true"></div>
  <DepthIndicator />
  <ProjectSlider projects={homeHeroProjects} />
  <div class="deep-sea-journey">
    <DeepSeaField />
    <MainProjectNavigator projects={homeProjects} />

    <section class="records-section snap-section" id="recent-records" aria-labelledby="records-title">
    <div class="constellation constellation-records" aria-hidden="true">
      <svg class="constellation-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
        <polyline points="4,24 27,8 53,31 77,53 96,28" />
        <polyline class="constellation-branch" points="53,31 62,76 84,88" />
      </svg>
      <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="container records-grid">
      <div class="record-column glass-pane">
        <HeroBorderTrace />
        <div class="column-heading">
          <h2 id="records-title" data-i18n="home.logs.title">{messages.ja['home.logs.title']}</h2>
          <p data-i18n="home.logs.description">{messages.ja['home.logs.description']}</p>
        </div>
        <ol class="timeline-list">
          {developmentLogs.map((log) => (
            <li>
              <span class="timeline-point" aria-hidden="true"></span>
              <time datetime={log.data.date.toISOString()} data-locale-ja={log.dateJa} data-locale-ko={log.dateKo}>{log.dateJa}</time>
              <a href={`/posts/${log.data.slug}/`}><LocalizedText value={log.data.title} /></a>
            </li>
          ))}
        </ol>
        <ArrowLink href="/blog/" tone="cool"><span data-i18n="home.logs.all">{messages.ja['home.logs.all']}</span></ArrowLink>
      </div>

      <div class="record-column glass-pane">
        <HeroBorderTrace />
        <div class="column-heading">
          <h2 data-i18n="home.posts.title">{messages.ja['home.posts.title']}</h2>
          <p data-i18n="home.posts.description">{messages.ja['home.posts.description']}</p>
        </div>
        <ol class="post-list">
          {recentPosts.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()} data-locale-ja={post.dateJa} data-locale-ko={post.dateKo}>{post.dateJa}</time>
              <a href={`/posts/${post.data.slug}/`}><LocalizedText value={post.data.title} /></a>
            </li>
          ))}
        </ol>
        <ArrowLink href="/blog/" tone="warm"><span data-i18n="home.posts.all">{messages.ja['home.posts.all']}</span></ArrowLink>
      </div>
    </div>
    </section>

    <section class="github-section snap-section" id="github-activity" aria-labelledby="github-title">
    <div class="container github-pane glass-pane">
      <HeroBorderTrace />
      <div class="constellation constellation-github" aria-hidden="true">
        <svg class="constellation-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
          <polyline points="96,12 75,24 51,41 27,62 45,82" />
          <polyline class="constellation-branch" points="51,41 66,71 82,63" />
        </svg>
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="github-heading">
        <div>
          <h2 id="github-title" data-i18n="home.github.title">{messages.ja['home.github.title']}</h2>
          <p data-i18n="home.github.description">{messages.ja['home.github.description']}</p>
        </div>
        <ArrowLink href="https://github.com/yunarang-dev" tone="warm" external><span data-i18n="home.github.profile">{messages.ja['home.github.profile']}</span></ArrowLink>
      </div>

      {githubActivity.length > 0 ? (
        <ol class="activity-list">
          {githubActivity.map((activity) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="6" cy="5" r="2" />
                <circle cx="18" cy="8" r="2" />
                <circle cx="8" cy="19" r="2" />
                <path d="M6 7v7a5 5 0 0 0 5 5M8 12h4a6 6 0 0 0 6-6" />
              </svg>
              <time datetime={activity.dateTime}>{activity.date}</time>
              <a href={activity.href} target="_blank" rel="noreferrer"><LocalizedText value={activity.label} /></a>
              <span>{activity.repository}</span>
            </li>
          ))}
        </ol>
      ) : (
        <div class="activity-fallback">
          <p data-i18n="home.github.description">{messages.ja['home.github.description']}</p>
        </div>
      )}

      <aside class="project-board-link" aria-labelledby="astral-days-board-title">
        <div class="project-board-link__copy">
          <p class="project-board-link__eyebrow" data-i18n="home.github.board.eyebrow">{messages.ja['home.github.board.eyebrow']}</p>
          <h3 id="astral-days-board-title" data-i18n="home.github.board.title">{messages.ja['home.github.board.title']}</h3>
          <p data-i18n="home.github.board.description">{messages.ja['home.github.board.description']}</p>
          <ArrowLink href="https://github.com/users/yunarang-dev/projects/1/views/2" tone="cool" external><span data-i18n="home.github.board.open">{messages.ja['home.github.board.open']}</span></ArrowLink>
        </div>
        <span class="project-board-link__status" data-i18n="home.github.board.status">{messages.ja['home.github.board.status']}</span>
      </aside>
    </div>
    </section>

    <section class="contact-section snap-section" id="contact" aria-labelledby="contact-title">
    <div class="container contact-pane glass-pane">
      <HeroBorderTrace />
      <div class="constellation constellation-contact" aria-hidden="true">
        <svg class="constellation-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
          <polyline points="94,12 61,31 38,57 72,86" />
          <polyline class="constellation-branch" points="38,57 16,77" />
        </svg>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <p class="contact-label" data-i18n="home.contact.eyebrow">{messages.ja['home.contact.eyebrow']}</p>
      <h2 id="contact-title" data-i18n="home.contact.title">{messages.ja['home.contact.title']}</h2>
      <p data-i18n="home.contact.description">{messages.ja['home.contact.description']}</p>
      <ul>
        <li><ArrowLink href="https://github.com/yunarang-dev" tone="warm" external><span data-i18n="home.contact.github">{messages.ja['home.contact.github']}</span></ArrowLink></li>
        <li><ArrowLink href="https://x.com/yunarang_dev" tone="warm" external><span data-i18n="home.contact.x">{messages.ja['home.contact.x']}</span></ArrowLink></li>
        <li><ArrowLink href="mailto:yunarang97@gmail.com" tone="warm"><span data-i18n="home.contact.email">{messages.ja['home.contact.email']}</span></ArrowLink></li>
      </ul>
    </div>
    </section>
  </div>
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.documentElement;
  let scrollFrame: number | undefined;
  let haloFrame: number | undefined;
  let haloX = window.innerWidth * 0.5;
  let haloY = window.innerHeight * 0.5;
  let haloTargetX = haloX;
  let haloTargetY = haloY;
  let wheelDelta = 0;
  let wheelGestureCommitted = false;
  let wheelGestureTimer: number | undefined;
  let wheelPagingTimer: number | undefined;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const snapSections = [...document.querySelectorAll<HTMLElement>('.snap-section')];
  const revealTargets = [
    ...document.querySelectorAll<HTMLElement>('.main-projects .project-rail > h2, .main-projects .project-tabs, .main-projects .project-panel.is-active > *'),
    ...document.querySelectorAll<HTMLElement>('.records-section .column-heading, .records-section .timeline-list, .records-section .post-list, .records-section .arrow-link'),
    ...document.querySelectorAll<HTMLElement>('.github-section .github-heading, .github-section .activity-list, .github-section .project-board-link'),
    ...document.querySelectorAll<HTMLElement>('.contact-pane > .contact-label, .contact-pane > h2, .contact-pane > p, .contact-pane > ul'),
  ];
  const depthIndicator = document.querySelector<HTMLElement>('[data-depth-indicator]');
  const depthValue = depthIndicator?.querySelector<HTMLElement>('[data-depth-value]');
  const depthLabel = depthIndicator?.querySelector<HTMLElement>('[data-depth-label]');
  const depthPoints = depthIndicator
    ? [...depthIndicator.querySelectorAll<HTMLAnchorElement>('[data-depth-point]')]
    : [];

  const updateGlassRefraction = () => {
    const position = window.scrollY;
    const scrollableHeight = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
    const depthProgress = Math.min(Math.max(position / scrollableHeight, 0), 1);
    const heroHeight = document.querySelector<HTMLElement>('[data-project-slider]')?.offsetHeight ?? window.innerHeight;
    const afterHeroProgress = Math.min(Math.max(position / Math.max(heroHeight, 1), 0), 1);
    const journeyProgress = Math.min(Math.max((position - heroHeight) / Math.max(scrollableHeight - heroHeight, 1), 0), 1);
    const deepWaterProgress = Math.min(Math.max((depthProgress - 0.52) / 0.28, 0), 1);
    const easedDepth = deepWaterProgress * deepWaterProgress * (3 - 2 * deepWaterProgress);
    const traceAnchors = [
      { element: document.querySelector<HTMLElement>('.main-projects'), strength: 1 },
      { element: document.querySelector<HTMLElement>('.records-section'), strength: 0.8 },
      { element: document.querySelector<HTMLElement>('.github-section'), strength: 0.6 },
      { element: document.querySelector<HTMLElement>('.contact-section'), strength: 0.4 },
    ].filter((anchor): anchor is { element: HTMLElement; strength: number } => anchor.element !== null);
    const depthAnchors = [
      { element: document.querySelector<HTMLElement>('#featured-projects'), depth: 0 },
      { element: document.querySelector<HTMLElement>('#main-projects'), depth: 80 },
      { element: document.querySelector<HTMLElement>('#recent-records'), depth: 240 },
      { element: document.querySelector<HTMLElement>('#github-activity'), depth: 480 },
      { element: document.querySelector<HTMLElement>('#contact'), depth: 720 },
    ].filter((anchor): anchor is { element: HTMLElement; depth: number } => anchor.element !== null);
    let borderTraceStrength = traceAnchors[0]?.strength ?? 1;
    let currentDepth = depthAnchors[0]?.depth ?? 0;

    for (let index = 0; index < traceAnchors.length - 1; index += 1) {
      const current = traceAnchors[index];
      const next = traceAnchors[index + 1];
      const currentTop = Math.min(current.element.getBoundingClientRect().top + position, scrollableHeight);
      const nextTop = Math.min(next.element.getBoundingClientRect().top + position, scrollableHeight);

      if (position < currentTop) break;

      if (position <= nextTop) {
        const interval = Math.max(nextTop - currentTop, 1);
        const intervalProgress = Math.min(Math.max((position - currentTop) / interval, 0), 1);
        borderTraceStrength = current.strength + (next.strength - current.strength) * intervalProgress;
        break;
      }

      borderTraceStrength = next.strength;
    }

    for (let index = 0; index < depthAnchors.length - 1; index += 1) {
      const current = depthAnchors[index];
      const next = depthAnchors[index + 1];
      // These sections live in different nested layout contexts. Resolve every
      // anchor against the document instead of mixing parent-relative offsets.
      const currentTop = current.element.getBoundingClientRect().top + position;
      const nextTop = next.element.getBoundingClientRect().top + position;

      if (position < currentTop) break;

      if (position <= nextTop) {
        const interval = Math.max(nextTop - currentTop, 1);
        const intervalProgress = Math.min(Math.max((position - currentTop) / interval, 0), 1);
        currentDepth = current.depth + (next.depth - current.depth) * intervalProgress;
        break;
      }

      currentDepth = next.depth;
    }

    if (depthValue && depthLabel && depthPoints.length > 0) {
      const nearestPoint = depthPoints.reduce((nearest, point) => {
        const pointDepth = Number(point.dataset.depthPoint ?? 0);
        const nearestDepth = Number(nearest.dataset.depthPoint ?? 0);
        return Math.abs(pointDepth - currentDepth) < Math.abs(nearestDepth - currentDepth) ? point : nearest;
      });

      depthValue.textContent = String(Math.round(currentDepth));
      depthLabel.textContent = root.dataset.locale === 'ko'
        ? nearestPoint.dataset.depthLabelKo ?? ''
        : nearestPoint.dataset.depthLabelJa ?? '';
      depthPoints.forEach((point) => {
        const active = point === nearestPoint;
        point.classList.toggle('is-active', active);
        if (active) point.setAttribute('aria-current', 'location');
        else point.removeAttribute('aria-current');
      });
    }
    // The central beam and the two panel reflections remain readable through
    // the journey, then dim only in the final deep-water section. The broad
    // and narrow streaks use independent drift values below.
    const refractionLight = 4.6 - easedDepth * 2.65;
    const refractionSoft = 1.55 - easedDepth * 0.78;
    root.style.setProperty('--refraction-light', String(refractionLight.toFixed(2)) + '%');
    root.style.setProperty('--refraction-soft', String(refractionSoft.toFixed(2)) + '%');
    root.style.setProperty('--refraction-visibility', String(afterHeroProgress.toFixed(2)));
    root.style.setProperty('--panel-reflection-light', String((refractionLight * 1.75).toFixed(2)) + '%');
    root.style.setProperty('--panel-reflection-soft', String((refractionLight * 1.18).toFixed(2)) + '%');
    root.style.setProperty('--home-border-trace-strength', borderTraceStrength.toFixed(4));
    root.style.setProperty('--journey-progress', journeyProgress.toFixed(3));
    root.style.setProperty('--journey-depth', easedDepth.toFixed(3));
    root.style.setProperty('--journey-current-opacity', String((0.36 - easedDepth * 0.17).toFixed(3)));
    root.style.setProperty('--journey-veil', String((0.18 + easedDepth * 0.3).toFixed(3)));

    if (reducedMotion.matches) {
      scrollFrame = undefined;
      return;
    }

    const shiftX = depthProgress * 3.2;
    const shiftY = depthProgress * 1.2;
    const refraction = 35 + depthProgress * 42;
    const softReflectionDrift = journeyProgress * 14;
    const lightReflectionDrift = journeyProgress * 28;
    const currentX = journeyProgress * 13;
    const currentY = journeyProgress * 3.4;
    const starDriftX = journeyProgress * -34;
    const starDriftY = journeyProgress * 20;
    const constellationX = journeyProgress * 18;
    const constellationY = journeyProgress * 7;
    root.style.setProperty('--glass-shift-x', String(shiftX.toFixed(2)) + 'px');
    root.style.setProperty('--glass-shift-y', String(shiftY.toFixed(2)) + 'px');
    root.style.setProperty('--glass-refraction', String(refraction.toFixed(2)) + '%');
    root.style.setProperty('--panel-reflection-soft-drift', String(softReflectionDrift.toFixed(2)) + '%');
    root.style.setProperty('--panel-reflection-light-drift', String(lightReflectionDrift.toFixed(2)) + '%');
    root.style.setProperty('--journey-current-x', String(currentX.toFixed(2)) + 'vw');
    root.style.setProperty('--journey-current-y', String(currentY.toFixed(2)) + 'svh');
    root.style.setProperty('--journey-star-drift-x', String(starDriftX.toFixed(2)) + 'px');
    root.style.setProperty('--journey-star-drift-y', String(starDriftY.toFixed(2)) + 'px');
    root.style.setProperty('--journey-constellation-x', String(constellationX.toFixed(2)) + 'px');
    root.style.setProperty('--journey-constellation-y', String(constellationY.toFixed(2)) + 'px');
    scrollFrame = undefined;
  };

  const requestRefractionUpdate = () => {
    if (scrollFrame !== undefined) return;
    scrollFrame = window.requestAnimationFrame(updateGlassRefraction);
  };

  const updateHalo = () => {
    haloX += (haloTargetX - haloX) * 0.055;
    haloY += (haloTargetY - haloY) * 0.055;
    root.style.setProperty('--halo-x', String(haloX.toFixed(1)) + 'px');
    root.style.setProperty('--halo-y', String(haloY.toFixed(1)) + 'px');

    if (Math.abs(haloTargetX - haloX) > 0.2 || Math.abs(haloTargetY - haloY) > 0.2) {
      haloFrame = window.requestAnimationFrame(updateHalo);
    } else {
      haloFrame = undefined;
    }
  };

  const requestHaloUpdate = () => {
    if (reducedMotion.matches || haloFrame !== undefined) return;
    haloFrame = window.requestAnimationFrame(updateHalo);
  };

  const updateHaloTarget = (event: PointerEvent) => {
    if (event.pointerType === 'touch') return;
    haloTargetX = event.clientX;
    haloTargetY = event.clientY;
    requestHaloUpdate();
  };

  const canScrollWithin = (target: EventTarget | null, direction: number) => {
    let element = target instanceof HTMLElement ? target : null;

    while (element && element !== document.body) {
      const style = window.getComputedStyle(element);
      const scrollable = /(auto|scroll)/.test(style.overflowY) && element.scrollHeight > element.clientHeight + 1;

      if (scrollable) {
        const canContinueDown = direction > 0 && element.scrollTop + element.clientHeight < element.scrollHeight - 1;
        const canContinueUp = direction < 0 && element.scrollTop > 1;
        if (canContinueDown || canContinueUp) return true;
      }

      element = element.parentElement;
    }

    return false;
  };

  const resetWheelGesture = () => {
    wheelDelta = 0;
    wheelGestureCommitted = false;
    wheelGestureTimer = undefined;
  };

  const finishWheelPaging = () => {
    root.classList.remove('is-home-wheel-paging');
    wheelPagingTimer = undefined;
  };

  const getSectionDestination = (direction: number) => {
    const position = window.scrollY;
    const sectionTops = snapSections.map((section) => section.getBoundingClientRect().top + position);
    const currentIndex = sectionTops.reduce(
      (nearest, top, index) => top <= position + window.innerHeight * 0.35 ? index : nearest,
      0,
    );

    return sectionTops[currentIndex + direction];
  };

  const startSectionPaging = (targetTop: number) => {
    root.classList.add('is-home-wheel-paging');
    window.scrollTo({ top: targetTop, behavior: 'smooth' });

    window.clearTimeout(wheelPagingTimer);
    wheelPagingTimer = window.setTimeout(finishWheelPaging, 820);
  };

  const handleSectionWheel = (event: WheelEvent) => {
    if (reducedMotion.matches || !finePointer.matches || window.innerWidth <= 768 || event.ctrlKey) return;
    if (Math.abs(event.deltaX) > Math.abs(event.deltaY) || event.deltaY === 0) return;

    const direction = Math.sign(event.deltaY);
    if (canScrollWithin(event.target, direction)) return;

    // Trackpads emit continuous pixel-based momentum events. Preserve that
    // stream without the section-paging lock, while applying a small gain so
    // tall Home sections do not feel resistant under proximity snapping.
    if (event.deltaMode === WheelEvent.DOM_DELTA_PIXEL) {
      event.preventDefault();
      const scrollingElement = document.scrollingElement;
      if (scrollingElement) scrollingElement.scrollTop += event.deltaY * 1.12;
      return;
    }

    const targetTop = getSectionDestination(direction);

    // At the first and final boundaries, retain native scrolling so the footer
    // and browser overscroll behavior remain reachable.
    if (targetTop === undefined) return;

    event.preventDefault();
    window.clearTimeout(wheelGestureTimer);
    wheelGestureTimer = window.setTimeout(resetWheelGesture, 180);

    if (wheelGestureCommitted || wheelPagingTimer !== undefined) return;

    const deltaMultiplier = event.deltaMode === WheelEvent.DOM_DELTA_LINE
      ? 16
      : event.deltaMode === WheelEvent.DOM_DELTA_PAGE
        ? window.innerHeight
        : 1;
    wheelDelta += event.deltaY * deltaMultiplier;

    if (Math.abs(wheelDelta) < 42) return;

    wheelGestureCommitted = true;
    startSectionPaging(targetTop);
  };

  const handleSectionKey = (event: KeyboardEvent) => {
    if (event.defaultPrevented || reducedMotion.matches || event.metaKey || event.ctrlKey || event.altKey) return;

    const target = event.target instanceof HTMLElement ? event.target : null;
    if (target?.closest('input, textarea, select, button, [contenteditable="true"]')) return;

    const isSpace = event.code === 'Space';
    if (!isSpace && event.key !== 'PageDown' && event.key !== 'PageUp') return;

    const direction = event.key === 'PageUp' || (isSpace && event.shiftKey) ? -1 : 1;
    const targetTop = getSectionDestination(direction);
    if (targetTop === undefined) return;

    event.preventDefault();
    if (wheelPagingTimer !== undefined) return;
    startSectionPaging(targetTop);
  };

  if (reducedMotion.matches || !('IntersectionObserver' in window)) {
    revealTargets.forEach((target) => target.classList.add('is-home-copy-visible'));
  } else {
    revealTargets.forEach((target, index) => {
      target.classList.add('home-copy-reveal');
      target.style.setProperty('--home-reveal-delay', `${Math.min(index % 4, 3) * 55}ms`);
    });

    let previousRevealScrollY = window.scrollY;
    const revealObserver = new IntersectionObserver((entries) => {
      const currentRevealScrollY = window.scrollY;
      const isScrollingUp = currentRevealScrollY < previousRevealScrollY;

      entries.forEach((entry) => {
        const target = entry.target as HTMLElement;

        if (entry.isIntersecting) {
          target.classList.add('is-home-copy-visible');
          return;
        }

        const lowerViewportEdge = entry.rootBounds?.bottom ?? window.innerHeight;
        const exitedBelowViewport = entry.boundingClientRect.top >= lowerViewportEdge;

        // Keep completed sections visible while travelling deeper. Reset them
        // only after an upward scroll carries them below the viewport, so the
        // next downward visit can reveal the copy again.
        if (isScrollingUp && exitedBelowViewport) {
          target.classList.remove('is-home-copy-visible');
        }
      });

      previousRevealScrollY = currentRevealScrollY;
    }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });

    revealTargets.forEach((target) => revealObserver.observe(target));
  }

  updateGlassRefraction();
  document.addEventListener('site:localechange', updateGlassRefraction);
  window.addEventListener('scroll', requestRefractionUpdate, { passive: true });
  window.addEventListener('resize', requestRefractionUpdate, { passive: true });
  window.addEventListener('pointermove', updateHaloTarget, { passive: true });
  window.addEventListener('wheel', handleSectionWheel, { passive: false });
  window.addEventListener('keydown', handleSectionKey);
  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) {
      window.clearTimeout(wheelGestureTimer);
      window.clearTimeout(wheelPagingTimer);
      resetWheelGesture();
      finishWheelPaging();
      if (haloFrame !== undefined) window.cancelAnimationFrame(haloFrame);
      haloFrame = undefined;
      root.style.removeProperty('--glass-shift-x');
      root.style.removeProperty('--glass-shift-y');
      root.style.removeProperty('--glass-refraction');
    } else {
      updateGlassRefraction();
    }
  });
</script>
