---
import { getCollection } from 'astro:content';
import ConstellationMotif from '../../components/ui/ConstellationMotif.astro';
import LocalizedText from '../../components/ui/LocalizedText.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/archive.css';

const timeZone = 'Asia/Seoul';
const formatDate = (date: Date, locale: 'ja-JP' | 'ko-KR') =>
  new Intl.DateTimeFormat(locale, {
    timeZone,
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((post) => ({
    ...post,
    dateJa: formatDate(post.data.date, 'ja-JP'),
    dateKo: formatDate(post.data.date, 'ko-KR'),
    year: new Intl.DateTimeFormat('en-US', { timeZone, year: 'numeric' }).format(post.data.date),
  }));
const constellationPalette = [
  { accent: 'rgb(130 174 255)', glow: 'rgb(130 174 255 / 48%)' },
  { accent: 'rgb(158 199 255)', glow: 'rgb(158 199 255 / 46%)' },
  { accent: 'rgb(116 190 220)', glow: 'rgb(116 190 220 / 42%)' },
  { accent: 'rgb(205 173 255)', glow: 'rgb(205 173 255 / 42%)' },
] as const;
const constellationGroupIndexes = new Map<string, number>();
const timelinePosts = posts.map((post) => {
  const projectId = post.data.project?.id;
  const group = projectId
    ? `project-${projectId}`
    : `category-${post.data.category.ja}`;
  const groupIndex = constellationGroupIndexes.get(group) ?? constellationGroupIndexes.size;

  if (!constellationGroupIndexes.has(group)) {
    constellationGroupIndexes.set(group, groupIndex);
  }

  return {
    post,
    group,
    tone: constellationPalette[groupIndex % constellationPalette.length],
  };
});
const site = Astro.site ?? Astro.url;
const archiveUrl = new URL('/archive/', site).href;
const archiveSchema = {
  '@type': 'CollectionPage',
  '@id': `${archiveUrl}#timeline`,
  name: 'Yunarang Development Archive Timeline',
  description: '現在から最初の記録まで、制作と開発の足跡を時系列で辿るアーカイブ。',
  url: archiveUrl,
  inLanguage: ['ja', 'ko'],
  isPartOf: { '@id': `${new URL('/', site).href}#website` },
};
---

<BaseLayout
  title="Archive Timeline — Yunarang"
  titleKo="아카이브 타임라인 — Yunarang"
  description="現在から最初の記録まで、制作と開発の足跡を時系列で辿るアーカイブ。"
  descriptionKo="현재에서 첫 기록까지, 제작과 개발의 흔적을 시간 순서대로 따라가는 아카이브입니다."
  structuredData={archiveSchema}
  pageClass="archive-page-root"
>
  <section class="archive-page content-container" aria-labelledby="archive-title">
    <ConstellationMotif variant="archive" class="constellation-motif--archive" />
    <header class="archive-hero">
      <p class="archive-eyebrow" data-i18n="archive.eyebrow">ARCHIVE TIMELINE</p>
      <h1 id="archive-title" data-i18n="archive.title">記録がつなぐ、制作の星座。</h1>
      <p class="archive-intro" data-i18n="archive.description">現在から最初の記録まで。制作、実装、学びの足跡を時系列で辿れます。</p>
      <div class="archive-meta" aria-label="Archive details">
        <span data-i18n="archive.order">LATEST → OLDEST</span>
        <span aria-hidden="true">·</span>
        <span>{posts.length} <span data-i18n="archive.count">記事</span></span>
      </div>
    </header>

    <ol class="archive-timeline" data-i18n-aria="archive.timeline.label" aria-label="投稿の時系列アーカイブ">
      {timelinePosts.map(({ post, group, tone }, index) => (
        <li
          class:list={['timeline-entry', { 'is-latest': index === 0 }]}
          data-constellation-group={group}
          style={`--constellation-accent: ${tone.accent}; --constellation-glow: ${tone.glow};`}
        >
          <time datetime={post.data.date.toISOString()} data-locale-ja={post.dateJa} data-locale-ko={post.dateKo}>{post.dateJa}</time>
          <span class="timeline-star" aria-hidden="true"><span></span></span>
          <article class="timeline-record">
            <div class="timeline-record__meta">
              <LocalizedText value={post.data.category} />
              <span aria-hidden="true">·</span>
              <span>{post.year}</span>
              {index === 0 && <span class="timeline-record__latest" data-i18n="archive.latest">LATEST RECORD</span>}
            </div>
            <h2><a href={`/posts/${post.data.legacySlug}/`}><LocalizedText value={post.data.title} /></a></h2>
            {post.data.description && <LocalizedText as="p" class="timeline-record__description" value={post.data.description} />}
            <a class="timeline-record__link" href={`/posts/${post.data.legacySlug}/`}>
              <span data-i18n="archive.open">記事を読む</span>
              <span aria-hidden="true">→</span>
            </a>
          </article>
        </li>
      ))}
    </ol>
  </section>

  <script>
    const timeline = document.querySelector<HTMLElement>('.archive-timeline');
    const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-constellation-group]'));

    const setActiveConstellation = (group?: string) => {
      timeline?.classList.toggle('is-constellation-filtering', Boolean(group));

      entries.forEach((entry) => {
        const isMatch = Boolean(group) && entry.dataset.constellationGroup === group;
        entry.classList.toggle('is-constellation-active', isMatch);
        entry.classList.toggle('is-constellation-muted', Boolean(group) && !isMatch);
      });
    };

    entries.forEach((entry) => {
      const group = entry.dataset.constellationGroup;
      if (!group) return;

      entry.addEventListener('pointerenter', () => setActiveConstellation(group));
      entry.addEventListener('pointerleave', () => setActiveConstellation());
      entry.addEventListener('focusin', () => setActiveConstellation(group));
      entry.addEventListener('focusout', (event) => {
        const nextTarget = event.relatedTarget;
        if (nextTarget instanceof Node && entry.contains(nextTarget)) return;
        setActiveConstellation();
      });
    });
  </script>
</BaseLayout>
