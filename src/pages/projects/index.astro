---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ConstellationMotif from '../../components/ui/ConstellationMotif.astro';
import HeroBorderTrace from '../../components/ui/HeroBorderTrace.astro';
import LocalizedText from '../../components/ui/LocalizedText.astro';
import ProjectIdentityMotif from '../../components/projects/ProjectIdentityMotif.astro';
import { messages, pageCopy } from '../../i18n/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/projects.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const site = Astro.site ?? Astro.url;
const projectsUrl = new URL('/projects/', site).href;
const projectsSchema = {
  '@type': 'CollectionPage',
  '@id': `${projectsUrl}#collection`,
  name: pageCopy.projects.metaTitle.ja,
  description: pageCopy.projects.metaDescription.ja,
  url: projectsUrl,
  inLanguage: ['ja', 'ko'],
  isPartOf: { '@id': `${new URL('/', site).href}#website` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/projects/${project.id}/`, site).href,
      name: project.data.title.ja,
    })),
  },
};
---

<BaseLayout
  title={pageCopy.projects.metaTitle.ja}
  titleKo={pageCopy.projects.metaTitle.ko}
  description={pageCopy.projects.metaDescription.ja}
  descriptionKo={pageCopy.projects.metaDescription.ko}
  structuredData={projectsSchema}
  pageClass="projects-page-root"
>
  <main class="projects-index">
    <ConstellationMotif variant="projects" class="constellation-motif--projects" />
    <header class="projects-index__hero content-container" data-scroll-reveal>
      <p class="projects-index__eyebrow" data-i18n="projects.eyebrow">{messages.ja['projects.eyebrow']}</p>
      <h1 data-i18n="projects.title">{messages.ja['projects.title']}</h1>
      <p class="projects-index__intro" data-i18n="projects.description">{messages.ja['projects.description']}</p>
    </header>

    <section class="projects-index__list container" aria-label={messages.ja['projects.list']} data-i18n-aria="projects.list">
      {projects.map((project, index) => (
        <article class:list={[
          'project-index-card',
          `project-index-card--${project.id}`,
          { 'project-index-card--reverse': index % 2 === 1 },
        ]}>
          <HeroBorderTrace />
          <div class="project-index-card__media">
            {project.data.heroImage && project.data.heroAlt && (
              <Image
                src={project.data.heroImage}
                alt={project.data.heroAlt}
                widths={[640, 960, 1280]}
                sizes="(max-width: 46rem) 100vw, 52vw"
                format="webp"
                quality={84}
              />
            )}
            <div class="project-index-card__media-shade" aria-hidden="true"></div>
            <span class="project-index-card__code" aria-hidden="true">{project.data.shortTitle}</span>
          </div>

          <div class="project-index-card__copy" data-scroll-reveal>
            <ProjectIdentityMotif projectId={project.id} />
            <div class="project-index-card__heading">
              <span class="project-index-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="project-index-card__status" data-i18n="project-page.status.active">{messages.ja['project-page.status.active']}</span>
            </div>
            <LocalizedText as="h2" value={project.data.title} />
            <LocalizedText as="p" class="project-index-card__tagline" value={project.data.tagline} />
            <LocalizedText as="p" class="project-index-card__overview" value={project.data.overview} />

            <dl class="project-index-card__meta">
              <div>
                <dt data-i18n="project-page.role">{messages.ja['project-page.role']}</dt>
                <dd>{project.data.role}</dd>
              </div>
              <div>
                <dt data-i18n="project-page.tools">{messages.ja['project-page.tools']}</dt>
                <dd>{project.data.technologies.join(' · ')}</dd>
              </div>
            </dl>

            <a class="project-index-card__link" href={`/projects/${project.id}/`}>
              <span data-i18n="project.open">{messages.ja['project.open']}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
