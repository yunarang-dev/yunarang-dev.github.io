---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ConstellationMotif from '../../components/ui/ConstellationMotif.astro';
import HeroBorderTrace from '../../components/ui/HeroBorderTrace.astro';
import LocalizedText from '../../components/ui/LocalizedText.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/projects.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const site = Astro.site ?? Astro.url;
const projectsUrl = new URL('/projects/', site).href;
const projectsSchema = {
  '@type': 'CollectionPage',
  '@id': `${projectsUrl}#collection`,
  name: 'Yunarang Projects',
  description: 'ゲーム、物語、AI開発環境を通して、作ることを探究する進行中のプロジェクト。',
  url: projectsUrl,
  inLanguage: ['ja', 'ko'],
  isPartOf: { '@id': `${new URL('/', site).href}#website` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/projects/${project.id}/`, site).href,
      name: project.data.title.ja,
    })),
  },
};
---

<BaseLayout
  title="Projects — Yunarang"
  titleKo="프로젝트 — Yunarang"
  description="ゲーム、物語、AI開発環境を通して、作ることを探究する進行中のプロジェクト。"
  descriptionKo="게임, 이야기, AI 개발 환경을 통해 만드는 일을 탐구하는 진행 중인 프로젝트입니다."
  structuredData={projectsSchema}
  pageClass="projects-page-root"
>
  <main class="projects-index">
    <ConstellationMotif variant="projects" class="constellation-motif--projects" />
    <header class="projects-index__hero container">
      <p class="projects-index__eyebrow" data-i18n="projects.eyebrow">SELECTED WORK</p>
      <h1 data-i18n="projects.title">Projects in progress.</h1>
      <p class="projects-index__intro" data-i18n="projects.description">
        ゲーム、物語、AI開発環境。異なる方法で「作ること」を試している現在進行形のプロジェクトです。
      </p>
    </header>

    <section class="projects-index__list container" aria-label="Projects">
      {projects.map((project, index) => (
        <article class:list={['project-index-card', { 'project-index-card--reverse': index % 2 === 1 }]}>
          <HeroBorderTrace />
          <div class="project-index-card__media">
            {project.data.heroImage && project.data.heroAlt && (
              <Image
                src={project.data.heroImage}
                alt={project.data.heroAlt}
                widths={[640, 960, 1280]}
                sizes="(max-width: 46rem) 100vw, 52vw"
                format="webp"
                quality={84}
              />
            )}
            <div class="project-index-card__media-shade" aria-hidden="true"></div>
            <span class="project-index-card__code" aria-hidden="true">{project.data.shortTitle}</span>
          </div>

          <div class="project-index-card__copy">
            <div class="project-index-card__heading">
              <span class="project-index-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="project-index-card__status" data-i18n="project-page.status.active">IN DEVELOPMENT</span>
            </div>
            <LocalizedText as="h2" value={project.data.title} />
            <LocalizedText as="p" class="project-index-card__tagline" value={project.data.tagline} />
            <LocalizedText as="p" class="project-index-card__overview" value={project.data.overview} />

            <dl class="project-index-card__meta">
              <div>
                <dt data-i18n="project-page.role">ROLE</dt>
                <dd>{project.data.role}</dd>
              </div>
              <div>
                <dt data-i18n="project-page.tools">TOOLS</dt>
                <dd>{project.data.technologies.join(' · ')}</dd>
              </div>
            </dl>

            <a class="project-index-card__link" href={`/projects/${project.id}/`}>
              <span data-i18n="project.open">プロジェクトを見る</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
