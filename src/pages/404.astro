---
import LocalizedText from '../components/ui/LocalizedText.astro';
import { getMessagePair } from '../i18n/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/not-found.css';

const title = getMessagePair('not-found.title');
const description = getMessagePair('not-found.description');
---

<BaseLayout
  title="Signal Lost — Yunarang"
  titleKo="길을 잃은 별 — Yunarang"
  description={description.ja}
  descriptionKo={description.ko}
  noindex
  overlayHeader
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__field" aria-hidden="true">
      <svg viewBox="0 0 1000 620" preserveAspectRatio="xMidYMid slice">
        <path class="not-found__path" d="m70 472 155-137 137 54 158-202 121 83" />
        <path class="not-found__path not-found__path--lost" d="m716 226 105-83 112 38" />
        <circle cx="70" cy="472" r="4" />
        <circle cx="225" cy="335" r="3" />
        <circle cx="362" cy="389" r="5" />
        <circle cx="520" cy="187" r="3.5" />
        <circle cx="641" cy="270" r="4" />
        <circle class="not-found__lost-star" cx="716" cy="226" r="7" />
        <circle cx="821" cy="143" r="3" />
        <circle cx="933" cy="181" r="4" />
      </svg>
    </div>

    <div class="not-found__content container">
      <div class="not-found__code" aria-hidden="true">404</div>
      <div class="not-found__copy" data-scroll-reveal>
        <p class="not-found__eyebrow" data-i18n="not-found.eyebrow">SIGNAL LOST</p>
        <LocalizedText as="h1" id="not-found-title" value={title} />
        <LocalizedText as="p" class="not-found__description" value={description} />

        <nav class="not-found__navigation" aria-label="記録へ戻る" data-i18n-aria="not-found.navigation">
          <a href="/">Home <span aria-hidden="true">↗</span></a>
          <a href="/blog/">Blog <span aria-hidden="true">↗</span></a>
          <a href="/wiki/">Wiki <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>
